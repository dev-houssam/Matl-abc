/* ---- prologue (%{ ... %}) ---- */
/* prologue de demonstration */

/* ---- constantes de token (%token), exposees comme fonctions ---- */
int TOK_IDENT() { return 0; }
int TOK_INT() { return 1; }
struct GenScanner {
    char* src;
    int pos;
    int len;
    int[1024] trans;
    int[4] is_final;
    char[256] yytext_buf;
    int yyleng;

    void init(char* source) {
        self.src = source;
        self.pos = 0;
        self.len = cast<int>(strlen(source));
        int i = 0;
        while (i < 1024) { self.trans[i] = -1; i = i + 1; }
        self.trans[9] = 1;
