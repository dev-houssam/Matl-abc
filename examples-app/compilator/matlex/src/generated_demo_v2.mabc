        self.trans[86] = 3;
        self.trans[87] = 3;
        self.trans[88] = 3;
        self.trans[89] = 3;
        self.trans[90] = 3;
        self.trans[95] = 3;
        self.trans[97] = 3;
        self.trans[98] = 3;
        self.trans[99] = 3;
        self.trans[100] = 3;
        self.trans[101] = 3;
        self.trans[102] = 3;
        self.trans[103] = 3;
        self.trans[104] = 3;
        self.trans[105] = 3;
        self.trans[106] = 3;
        self.trans[107] = 3;
        self.trans[108] = 3;
        self.trans[109] = 3;
        self.trans[110] = 3;
        self.trans[111] = 3;
        self.trans[112] = 3;
        self.trans[113] = 3;
        self.trans[114] = 3;
        self.trans[115] = 3;
        self.trans[116] = 3;
        self.trans[117] = 3;
        self.trans[118] = 3;
        self.trans[119] = 3;
        self.trans[120] = 3;
        self.trans[121] = 3;
        self.trans[122] = 3;
        self.trans[265] = 1;
        self.trans[266] = 1;
        self.trans[269] = 1;
        self.trans[288] = 1;
        self.trans[560] = 2;
        self.trans[561] = 2;
        self.trans[562] = 2;
        self.trans[563] = 2;
        self.trans[564] = 2;
        self.trans[565] = 2;
        self.trans[566] = 2;
        self.trans[567] = 2;
        self.trans[568] = 2;
        self.trans[569] = 2;
        self.trans[833] = 3;
        self.trans[834] = 3;
        self.trans[835] = 3;
        self.trans[836] = 3;
