        self.trans[855] = 3;
        self.trans[856] = 3;
        self.trans[857] = 3;
        self.trans[858] = 3;
        self.trans[863] = 3;
        self.trans[865] = 3;
        self.trans[866] = 3;
        self.trans[867] = 3;
        self.trans[868] = 3;
        self.trans[869] = 3;
        self.trans[870] = 3;
        self.trans[871] = 3;
