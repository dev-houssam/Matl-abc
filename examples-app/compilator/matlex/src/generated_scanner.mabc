        self.is_final[13] = 2;
    }

    int at_end() { return self.pos >= self.len; }

    int step(int state, char c) {
        int b = cast<int>(c);
        if (b < 0) { return -1; }
        return self.trans[state * 256 + b];
    }

    TokenSpan next_token() {
        TokenSpan tok;
        tok.start = self.pos;
        int state = 0;
        int best_rule = -1;
        int best_i = 0;
        int i = 0;
        while (self.pos + i < self.len) {
            char c = self.src[self.pos + i];
            int nstate = self.step(state, c);
            if (nstate == -1) { break; }
            state = nstate;
            i = i + 1;
            if (self.is_final[state] != -1) { best_rule = self.is_final[state]; best_i = i; }
        }
        if (best_rule == -1) { tok.rule_id = -2; tok.len = 1; self.pos = self.pos + 1; return tok; }
        tok.rule_id = best_rule;
        tok.len = best_i;
        self.pos = self.pos + best_i;
        return tok;
    }

    TokenSpan next_real_token() {
        TokenSpan tok = self.next_token();
        while (tok.rule_id == 0 && self.at_end() == 0) { tok = self.next_token(); }
        return tok;
    }
}

str gen_rule_name(int r) {
    if (r == 0) return "WS";
    if (r == 1) return "IDENT";
    if (r == 2) return "FLOAT";
    if (r == 3) return "INT";
    if (r == 4) return "PLUS";
    if (r == 5) return "MINUS";
    if (r == 6) return "STAR";
    if (r == 7) return "SLASH";
    if (r == 8) return "LPAREN";
    if (r == 9) return "RPAREN";
    if (r == 10) return "ASSIGN";
    if (r == 11) return "SEMI";
    if (r == -2) return "ERREUR";
    return "?";
}

int main() {
    GenScanner sc;
    sc.init("x = 3 + 4;");
    printf("=== Scanner genere : tokenisation de 'x = 3 + 4;' ===\n");
    while (sc.at_end() == 0) {
        TokenSpan tok = sc.next_real_token();
        printf("  [%2d:%2d] %s\n", tok.start, tok.len, gen_rule_name(tok.rule_id).data());
    }
    return 0;
}
