/* =====================================================
 * Scanner genere automatiquement par matlex (round 7, .max)
 * NE PAS EDITER A LA MAIN -- regenerer depuis la spec .max
 * ===================================================== */

import <cstd>
import <cstring>

/* Symbol : transporte un token vers un futur parser matyacc
   (type + position + valeur semantique optionnelle), a la
   maniere du Symbol de CUP consomme par un lexer JFlex. Le
   TYPE reste un simple entier : matlex ne connait pas les
   noms symboliques des tokens, c'est le role de matyacc. */
struct Symbol {
    int sym_type;
    int line;
    int column;
    int ivalue;
    str svalue;
}

struct GenScanner {
    char* src;
    int pos;
    int len;
    int[1024] trans;
    int[4] is_final;
    char[256] yytext_buf;
    int yyleng_val;
    int yychar_val;
    int yyline;
    int yycolumn;
    int lex_state;

    void init(char* source) {
        self.src = source;
        self.pos = 0;
        self.len = cast<int>(strlen(source));
        self.yychar_val = 0;
        self.yyline = 0;
        self.yycolumn = 0;
        self.lex_state = 0;
        int i = 0;
        while (i < 1024) { self.trans[i] = -1; i = i + 1; }
        self.trans[9] = 1;
        self.trans[10] = 1;
        self.trans[13] = 1;
        self.trans[32] = 1;
        self.trans[48] = 2;
        self.trans[49] = 2;
        self.trans[50] = 2;
        self.trans[51] = 2;
        self.trans[52] = 2;
        self.trans[53] = 2;
        self.trans[54] = 2;
        self.trans[55] = 2;
        self.trans[56] = 2;
        self.trans[57] = 2;
        self.trans[65] = 3;
        self.trans[66] = 3;
        self.trans[67] = 3;
        self.trans[68] = 3;
        self.trans[69] = 3;
        self.trans[70] = 3;
        self.trans[71] = 3;
        self.trans[72] = 3;
        self.trans[73] = 3;
        self.trans[74] = 3;
        self.trans[75] = 3;
        self.trans[76] = 3;
        self.trans[77] = 3;
        self.trans[78] = 3;
        self.trans[79] = 3;
        self.trans[80] = 3;
        self.trans[81] = 3;
        self.trans[82] = 3;
        self.trans[83] = 3;
        self.trans[84] = 3;
        self.trans[85] = 3;
        self.trans[86] = 3;
        self.trans[87] = 3;
        self.trans[88] = 3;
        self.trans[89] = 3;
        self.trans[90] = 3;
        self.trans[95] = 3;
        self.trans[97] = 3;
        self.trans[98] = 3;
        self.trans[99] = 3;
        self.trans[100] = 3;
        self.trans[101] = 3;
        self.trans[102] = 3;
        self.trans[103] = 3;
        self.trans[104] = 3;
        self.trans[105] = 3;
        self.trans[106] = 3;
        self.trans[107] = 3;
        self.trans[108] = 3;
        self.trans[109] = 3;
        self.trans[110] = 3;
        self.trans[111] = 3;
        self.trans[112] = 3;
        self.trans[113] = 3;
        self.trans[114] = 3;
        self.trans[115] = 3;
        self.trans[116] = 3;
        self.trans[117] = 3;
        self.trans[118] = 3;
        self.trans[119] = 3;
        self.trans[120] = 3;
        self.trans[121] = 3;
        self.trans[122] = 3;
        self.trans[265] = 1;
        self.trans[266] = 1;
        self.trans[269] = 1;
        self.trans[288] = 1;
        self.trans[560] = 2;
        self.trans[561] = 2;
        self.trans[562] = 2;
        self.trans[563] = 2;
        self.trans[564] = 2;
        self.trans[565] = 2;
        self.trans[566] = 2;
        self.trans[567] = 2;
        self.trans[568] = 2;
        self.trans[569] = 2;
        self.trans[816] = 3;
        self.trans[817] = 3;
        self.trans[818] = 3;
        self.trans[819] = 3;
        self.trans[820] = 3;
        self.trans[821] = 3;
        self.trans[822] = 3;
        self.trans[823] = 3;
        self.trans[824] = 3;
        self.trans[825] = 3;
        self.trans[833] = 3;
        self.trans[834] = 3;
        self.trans[835] = 3;
        self.trans[836] = 3;
        self.trans[837] = 3;
        self.trans[838] = 3;
        self.trans[839] = 3;
        self.trans[840] = 3;
        self.trans[841] = 3;
        self.trans[842] = 3;
        self.trans[843] = 3;
        self.trans[844] = 3;
        self.trans[845] = 3;
        self.trans[846] = 3;
        self.trans[847] = 3;
        self.trans[848] = 3;
        self.trans[849] = 3;
        self.trans[850] = 3;
        self.trans[851] = 3;
        self.trans[852] = 3;
        self.trans[853] = 3;
        self.trans[854] = 3;
        self.trans[855] = 3;
        self.trans[856] = 3;
        self.trans[857] = 3;
        self.trans[858] = 3;
        self.trans[863] = 3;
        self.trans[865] = 3;
        self.trans[866] = 3;
        self.trans[867] = 3;
        self.trans[868] = 3;
        self.trans[869] = 3;
        self.trans[870] = 3;
        self.trans[871] = 3;
        self.trans[872] = 3;
        self.trans[873] = 3;
        self.trans[874] = 3;
        self.trans[875] = 3;
        self.trans[876] = 3;
        self.trans[877] = 3;
        self.trans[878] = 3;
        self.trans[879] = 3;
        self.trans[880] = 3;
        self.trans[881] = 3;
        self.trans[882] = 3;
        self.trans[883] = 3;
        self.trans[884] = 3;
        self.trans[885] = 3;
        self.trans[886] = 3;
        self.trans[887] = 3;
        self.trans[888] = 3;
        self.trans[889] = 3;
        self.trans[890] = 3;
        self.is_final[0] = -1;
        self.is_final[1] = 0;
        self.is_final[2] = 2;
        self.is_final[3] = 1;
    }

    int at_end() { return self.pos >= self.len; }

    int step(int state, char c) {
        int b = cast<int>(c);
        if (b < 0) { return -1; }
        return self.trans[state * 256 + b];
    }

    /* API JFlex -- champs/methodes exposes a l'utilisateur */
    str yytext() { return &self.yytext_buf; }
    int yylength() { return self.yyleng_val; }
    int yychar() { return self.yychar_val; }
    int yystate() { return self.lex_state; }
    void yybegin(int s) { self.lex_state = s; }
    void yypushback(int n) {
        self.pos = self.pos - n;
        if (self.pos < 0) { self.pos = 0; }
    }
    void yyreset(char* new_source) {
        self.init(new_source);
    }

    /* Avance yyline/yycolumn de n caracteres a partir de self.pos. */
    void advance_line_col(int n) {
        int i = 0;
        while (i < n) {
            char c = self.src[self.pos + i];
            if (c == cast<char>(10)) { self.yyline = self.yyline + 1; self.yycolumn = 0; }
            else { self.yycolumn = self.yycolumn + 1; }
            i = i + 1;
        }
    }

    /* Une passe de maximal munch ; remplit yytext_buf/yyleng_val.
       Retourne l'id de regle gagnante, ou -1 si aucune regle
       n'accepte (erreur lexicale -- 1 caractere consomme). */
    int scan_one() {
        self.yychar_val = self.pos;
        int state = 0;
        int best_rule = -1;
        int best_i = 0;
        int i = 0;
        while (self.pos + i < self.len) {
            char c = self.src[self.pos + i];
            int nstate = self.step(state, c);
            if (nstate == -1) { break; }
            state = nstate;
            i = i + 1;
            if (self.is_final[state] != -1) { best_rule = self.is_final[state]; best_i = i; }
        }
        if (best_rule == -1) {
            self.yyleng_val = 1;
            self.yytext_buf[0] = self.src[self.pos];
            self.yytext_buf[1] = cast<char>(0);
            self.advance_line_col(1);
            self.pos = self.pos + 1;
            return -1;
        }
        self.yyleng_val = best_i;
        int k = 0;
        while (k < best_i && k < 255) { self.yytext_buf[k] = self.src[self.pos + k]; k = k + 1; }
        self.yytext_buf[k] = cast<char>(0);
        self.advance_line_col(best_i);
        self.pos = self.pos + best_i;
        return best_rule;
    }

    /* ---- prologue utilisateur (%{ ... %}), methodes ---- */
Symbol symbol(int t) {
    Symbol s;
    s.sym_type = t;
    s.line = self.yyline;
    s.column = self.yycolumn;
    s.ivalue = 0;
    return s;
}

    /* yylex() : boucle de scan style flex/JFlex.
       Symbol.sym_type == -1 signale la fin d'entree. */
    Symbol yylex() {
        int cont = 1;
        Symbol result;
        result.sym_type = -1;
        result.line = self.yyline;
        result.column = self.yycolumn;
        result.ivalue = 0;
        while (cont == 1) {
            if (self.at_end()) {
                cont = 0;
            } else {
                int rid = self.scan_one();
                if (rid == -1) {
                    int lex_err = 1;
                } else if (rid == 0) { int skip = 0; }
                else if (rid == 1) { return self.symbol(0); }
                else if (rid == 2) { return self.symbol(1); }
            }
        }
        return result;
    }
}

int read_whole_file(char* path, char* buf, int cap) {
    char* mode = "r";
    char* f = fopen(path, mode);
    if (f == null) { return -1; }
    int off = 0;
    char* got = fgets(buf + off, cap - off, f);
    while (got != null) {
        off = off + cast<int>(strlen(buf + off));
        if (cap - off < 2) { got = null; } else { got = fgets(buf + off, cap - off, f); }
    }
    fclose(f);
    buf[off] = cast<char>(0);
    return off;
}

int main(int argc, char** argv) {
    char[65536] buf;
    int off = 0;

    if (argc > 1) {
        int n = read_whole_file(argv[1], &buf, 65536);
        if (n < 0) { printf("Erreur : impossible de lire '%s'\n", argv[1]); return 1; }
    } else {
        int done = 0;
        while (done == 0) {
            char[1024] line;
            int lp = 0;
            int c = getchar();
            while (c != -1 && cast<char>(c) != cast<char>(10) && lp < 1023) { line[lp] = cast<char>(c); lp = lp + 1; c = getchar(); }
            line[lp] = cast<char>(0);
            if (c == -1 && lp == 0) { done = 1; }
            else if (lp == 3 && line[0] == 'E' && line[1] == 'O' && line[2] == 'F') { done = 1; }
            else {
                int i = 0;
                while (i < lp && off < 65535) { buf[off] = line[i]; off = off + 1; i = i + 1; }
                if (off < 65535) { buf[off] = cast<char>(10); off = off + 1; }
                if (c == -1) { done = 1; }
            }
        }
        buf[off] = cast<char>(0);
    }

    GenScanner sc;
    sc.init(&buf);

    Symbol tok = sc.yylex();
    while (tok.sym_type != -1) {
        printf("type=%d  yytext='%s'  ligne=%d colonne=%d\n", tok.sym_type, sc.yytext().data(), tok.line, tok.column);
        tok = sc.yylex();
    }
    return 0;
}
