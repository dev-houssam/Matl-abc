/* ===========================================================
 * matlex — generateur de lexer pour MATL-ABC (equivalent flex/JFlex)
 * ===========================================================
 * ROUND 6 : definitions nommees {NOM}, comptage d'accolades robuste
 * (conscient des chaines/caracteres litteraux), et API complete
 * façon JFlex (yytext(), yylength(), yychar(), yyline, yycolumn,
 * yybegin/yystate, yypushback, yyreset, %struct, %unicode, %line,
 * %column).
 *
 * Nouveautes round 6 par rapport au round 5 :
 *
 *   - Definitions nommees : des lignes "NOM = def_regex" dans la section
 *     de declarations (avant le premier %%) sont memorisees, et toute
 *     reference "{NOM}" dans une regle ULTERIEURE (ou une definition
 *     ULTERIEURE) est remplacee par "(def_regex)". Chaque definition est
 *     expansee au moment de sa propre declaration (donc une
 *     definition peut reutiliser une definition plus ancienne, comme
 *     "ID = {LETTRE}({LETTRE}|{CHIFFRE}|_)*").
 *
 *   - Comptage d'accolades des actions desormais CONSCIENT des
 *     chaines litterales "..." et caracteres litteraux '...' : un
 *     '}' a l'interieur d'une chaine ne referme plus prematurement
 *     l'action (bug documente au round 5, corrige ici).
 *
 *   - API generee façon JFlex, exposee comme METHODES du scanner
 *     (self.yytext(), etc.) -- mais l'utilisateur peut ECRIRE ses
 *     actions avec la syntaxe JFlex habituelle SANS "self." (juste
 *     yytext(), yyline, ...) : matlex REECRIT automatiquement ces
 *     identifiants connus en self.xxx au moment de la generation
 *     (rewrite_yy_calls()), pour coller a la syntaxe JFlex montree
 *     par l'utilisateur tout en respectant la regle MATL-ABC qui
 *     exige un "self." explicite pour les appels de methode.
 *
 *   - Directives %struct NOM (renomme la struct generee, "GenScanner"
 *     par defaut), %line / %column (suivi ligne/colonne -- en
 *     pratique TOUJOURS actif dans le code genere, ces directives
 *     sont reconnues mais n'ajoutent rien de plus : simplification
 *     assumee), %unicode (reconnue et ANALYSEE mais SANS EFFET --
 *     le moteur reste octet-par-octet ; un vrai support Unicode/UTF-8
 *     serait un chantier a part entiere, hors de portee ici).
 * =========================================================== */

import <cstd>
import <cstring>

struct Frag {
    int start;
    int accept;
}

struct NFA {
    int  state_count;
    int  trans_count;
    int  start;
    int  accept;

    int[4096]      trans_from;
    int[4096]      trans_to;
    char[4096]     trans_sym;
    int[4096]      trans_kind;   /* 0=char 1=eps 2=any 3=classe */
    int[4096]      trans_class;  /* id de classe, valide si kind==3 */

    int      class_count;
    int[64]  class_neg;
    int[64]  class_range_count;
    char[1024] class_lo;   /* 64 classes * 16 plages, aplati */
    char[1024] class_hi;

    int[4096] accept_rule;  /* id de regle pour un etat acceptant, -1 sinon */

    void init() {
        self.state_count = 0;
        self.trans_count = 0;
        self.start       = -1;
        self.accept      = -1;
        self.class_count = 0;
        int i = 0;
        while (i < 4096) { self.accept_rule[i] = -1; i = i + 1; }
    }

    int new_state() {
        int id = self.state_count;
        self.state_count = self.state_count + 1;
        return id;
    }

    void add_edge(int from, int to, char sym, int kind) {
        int i = self.trans_count;
        self.trans_from[i]  = from;
        self.trans_to[i]    = to;
        self.trans_sym[i]   = sym;
        self.trans_kind[i]  = kind;
        self.trans_count    = i + 1;
    }

    void add_class_edge(int from, int to, int class_id) {
        int i = self.trans_count;
        self.trans_from[i]   = from;
        self.trans_to[i]     = to;
        self.trans_kind[i]   = 3;
        self.trans_class[i]  = class_id;
        self.trans_count     = i + 1;
    }

    int new_class(int neg) {
        int id = self.class_count;
        self.class_neg[id]         = neg;
        self.class_range_count[id] = 0;
        self.class_count           = id + 1;
        return id;
    }

    void add_class_range(int class_id, char lo, char hi) {
        int i = self.class_range_count[class_id];
        self.class_lo[class_id * 16 + i] = lo;
        self.class_hi[class_id * 16 + i] = hi;
        self.class_range_count[class_id] = i + 1;
    }

    int char_in_class(int class_id, char c) {
        int i = 0;
        int found = 0;
        while (i < self.class_range_count[class_id]) {
            char lo = self.class_lo[class_id * 16 + i];
            char hi = self.class_hi[class_id * 16 + i];
            if (c >= lo && c <= hi) { found = 1; }
            i = i + 1;
        }
        if (self.class_neg[class_id] == 1) {
            if (found == 1) { return 0; }
            return 1;
        }
        return found;
    }

    /* Est-ce que la transition k accepte le caractere c ? (kind != 1) */
    int trans_accepts(int k, char c) {
        int kind = self.trans_kind[k];
        if (kind == 0) { return self.trans_sym[k] == c; }
        if (kind == 2) { return 1; }
        if (kind == 3) { return self.char_in_class(self.trans_class[k], c); }
        return 0;
    }

    void eps_closure(int* set) {
        int changed = 1;
        while (changed == 1) {
            changed = 0;
            int i = 0;
            while (i < self.trans_count) {
                if (self.trans_kind[i] == 1) {
                    int from = self.trans_from[i];
                    int to   = self.trans_to[i];
                    if (set[from] == 1 && set[to] == 0) {
                        set[to] = 1;
                        changed = 1;
                    }
                }
                i = i + 1;
            }
        }
    }

    int matches(char* input) {
        int n = cast<int>(strlen(input));

        int[4096] cur;
        int i = 0;
        while (i < self.state_count) { cur[i] = 0; i = i + 1; }
        cur[self.start] = 1;
        self.eps_closure(&cur);

        int pos = 0;
        while (pos < n) {
            char c = input[pos];
            int[4096] nxt;
            int j = 0;
            while (j < self.state_count) { nxt[j] = 0; j = j + 1; }

            int k = 0;
            while (k < self.trans_count) {
                if (self.trans_kind[k] != 1) {
                    if (cur[self.trans_from[k]] == 1 && self.trans_accepts(k, c) == 1) {
                        nxt[self.trans_to[k]] = 1;
                    }
                }
                k = k + 1;
            }
            self.eps_closure(&nxt);

            int m = 0;
            while (m < self.state_count) { cur[m] = nxt[m]; m = m + 1; }
            pos = pos + 1;
        }

        return cur[self.accept];
    }
}

struct RegexParser {
    char* pat;
    int   pos;
    int   len;
    NFA*  nfa;

    void init(char* pattern, NFA* target) {
        self.pat = pattern;
        self.pos = 0;
        self.len = cast<int>(strlen(pattern));
        self.nfa = target;
    }

    int at_end() {
        return self.pos >= self.len;
    }

    char peek() {
        if (self.at_end()) return cast<char>(0);
        return self.pat[self.pos];
    }

    char peek2() {
        if (self.pos + 1 >= self.len) return cast<char>(0);
        return self.pat[self.pos + 1];
    }

    char advance() {
        char c = self.pat[self.pos];
        self.pos = self.pos + 1;
        return c;
    }

    /* ---- constructeurs de fragments Thompson ---- */

    Frag frag_char(char c) {
        int s = self.nfa.new_state();
        int a = self.nfa.new_state();
        self.nfa.add_edge(s, a, c, 0);
        Frag f;
        f.start  = s;
        f.accept = a;
        return f;
    }

    Frag frag_any() {
        int s = self.nfa.new_state();
        int a = self.nfa.new_state();
        self.nfa.add_edge(s, a, cast<char>(0), 2);
        Frag f;
        f.start  = s;
        f.accept = a;
        return f;
    }

    Frag frag_class(int class_id) {
        int s = self.nfa.new_state();
        int a = self.nfa.new_state();
        self.nfa.add_class_edge(s, a, class_id);
        Frag f;
        f.start  = s;
        f.accept = a;
        return f;
    }

    Frag frag_concat(Frag a, Frag b) {
        self.nfa.add_edge(a.accept, b.start, cast<char>(0), 1);
        Frag f;
        f.start  = a.start;
        f.accept = b.accept;
        return f;
    }

    Frag frag_union(Frag a, Frag b) {
        int s   = self.nfa.new_state();
        int acc = self.nfa.new_state();
        self.nfa.add_edge(s, a.start, cast<char>(0), 1);
        self.nfa.add_edge(s, b.start, cast<char>(0), 1);
        self.nfa.add_edge(a.accept, acc, cast<char>(0), 1);
        self.nfa.add_edge(b.accept, acc, cast<char>(0), 1);
        Frag f;
        f.start  = s;
        f.accept = acc;
        return f;
    }

    Frag frag_star(Frag a) {
        int s   = self.nfa.new_state();
        int acc = self.nfa.new_state();
        self.nfa.add_edge(s, a.start, cast<char>(0), 1);
        self.nfa.add_edge(s, acc, cast<char>(0), 1);
        self.nfa.add_edge(a.accept, a.start, cast<char>(0), 1);
        self.nfa.add_edge(a.accept, acc, cast<char>(0), 1);
        Frag f;
        f.start  = s;
        f.accept = acc;
        return f;
    }

    Frag frag_plus(Frag a) {
        int acc = self.nfa.new_state();
        self.nfa.add_edge(a.accept, a.start, cast<char>(0), 1);
        self.nfa.add_edge(a.accept, acc, cast<char>(0), 1);
        Frag f;
        f.start  = a.start;
        f.accept = acc;
        return f;
    }

    Frag frag_optional(Frag a) {
        int s   = self.nfa.new_state();
        int acc = self.nfa.new_state();
        self.nfa.add_edge(s, a.start, cast<char>(0), 1);
        self.nfa.add_edge(s, acc, cast<char>(0), 1);
        self.nfa.add_edge(a.accept, acc, cast<char>(0), 1);
        Frag f;
        f.start  = s;
        f.accept = acc;
        return f;
    }

    /* Traduit une lettre d'echappement standard (t/n/r) vers l'octet
       de controle correspondant ; tout autre caractere s'echappe
       lui-meme (comportement deja en place au round 1-3). Necessaire
       pour pouvoir ecrire des patterns comme "[ \t\n\r]+" dans une
       SPEC TEXTE (round 4) sans devoir y injecter de vrais octets de
       controle, qui casseraient le decoupage ligne-par-ligne. */
    char resolve_escape(char e) {
        if (e == 't') { return cast<char>(9); }
        if (e == 'n') { return cast<char>(10); }
        if (e == 'r') { return cast<char>(13); }
        return e;
    }

    /* ---- classes : '[' '^'? (char | char'-'char)+ ']' ---- */

    Frag parse_class() {
        self.advance(); /* '[' */
        int neg = 0;
        if (self.peek() == '^') {
            neg = 1;
            self.advance();
        }
        int cid = self.nfa.new_class(neg);

        while (!self.at_end() && self.peek() != ']') {
            char c1 = self.advance();
            if (c1 == '\\') { c1 = self.resolve_escape(self.advance()); }

            if (!self.at_end() && self.peek() == '-' && self.peek2() != ']' && self.peek2() != cast<char>(0)) {
                self.advance(); /* '-' */
                char c2 = self.advance();
                if (c2 == '\\') { c2 = self.resolve_escape(self.advance()); }
                self.nfa.add_class_range(cid, c1, c2);
            } else {
                self.nfa.add_class_range(cid, c1, c1);
            }
        }
        if (self.peek() == ']') { self.advance(); }

        return self.frag_class(cid);
    }

    /* ---- descente recursive ---- */

    Frag parse_atom() {
        char c = self.peek();
        if (c == '(') {
            self.advance();
            Frag f = self.parse_union();
            if (self.peek() == ')') { self.advance(); }
            return f;
        }
        if (c == '[') {
            return self.parse_class();
        }
        if (c == '.') {
            self.advance();
            return self.frag_any();
        }
        if (c == '\\') {
            self.advance();
            char e = self.advance();
            return self.frag_char(self.resolve_escape(e));
        }
        self.advance();
        return self.frag_char(c);
    }

    Frag parse_repeat() {
        Frag a = self.parse_atom();
        if (!self.at_end()) {
            char c = self.peek();
            if (c == '*') { self.advance(); return self.frag_star(a); }
            if (c == '+') { self.advance(); return self.frag_plus(a); }
            if (c == '?') { self.advance(); return self.frag_optional(a); }
        }
        return a;
    }

    Frag parse_concat() {
        Frag left = self.parse_repeat();
        while (!self.at_end() && self.peek() != '|' && self.peek() != ')') {
            Frag right = self.parse_repeat();
            left = self.frag_concat(left, right);
        }
        return left;
    }

    Frag parse_union() {
        Frag left = self.parse_concat();
        while (!self.at_end() && self.peek() == '|') {
            self.advance();
            Frag right = self.parse_concat();
            left = self.frag_union(left, right);
        }
        return left;
    }

    void compile() {
        Frag f = self.parse_union();
        self.nfa.start  = f.start;
        self.nfa.accept = f.accept;
    }

    /* Compile 'self.pat' comme fragment INDEPENDANT rattache par
       epsilon a l'etat START COMMUN du NFA (self.nfa.start, deja
       cree par l'appelant avant le premier appel a compile_rule).
       L'etat d'acceptation du fragment est marque avec rule_id.
       Permet de combiner plusieurs regles dans UN SEUL NFA, ce que
       compile() (mono-regle) ne fait pas. */
    void compile_rule(int rule_id) {
        Frag f = self.parse_union();
        self.nfa.add_edge(self.nfa.start, f.start, cast<char>(0), 1);
        self.nfa.accept_rule[f.accept] = rule_id;
    }
}

/* ===========================================================
 * ETAPE B : NFA -> DFA (subset construction)
 * ===========================================================
 * DFA a capacite fixe (128 etats max, alphabet = 256 octets).
 * Chaque etat DFA correspond a un SOUS-ENSEMBLE d'etats NFA
 * (apres cloture epsilon). On represente ce sous-ensemble comme
 * une LISTE TRIEE d'ids d'etats NFA (triee naturellement car on
 * la construit en parcourant les etats NFA dans l'ordre croissant)
 * plutot qu'un tableau d'appartenance complet -- moins de memoire,
 * et compare-egalite en O(longueur) au lieu de O(nfa.state_count).
 * =========================================================== */

struct DFA {
    int  state_count;
    int  start;
    int[128]   is_final;   /* id de regle GAGNANTE pour cet etat, -1 si non acceptant */
    int[32768] trans;      /* aplati [etat*256 + octet] -> etat ou -1 */

    void init() {
        self.state_count = 0;
        self.start       = -1;
        int i = 0;
        while (i < 32768) { self.trans[i] = -1; i = i + 1; }
        i = 0;
        while (i < 128) { self.is_final[i] = -1; i = i + 1; }
    }

    int step(int state, char c) {
        int b = cast<int>(c);
        if (b < 0) { return -1; }  /* octets >127 non geres (limitation documentee) */
        return self.trans[state * 256 + b];
    }

    /* Correspondance PLEINE CHAINE (round 2) : conservee pour tests
       mono-regle. Retourne 1 si 'input' est integralement reconnu
       par N'IMPORTE QUELLE regle du DFA, 0 sinon. */
    int matches(char* input) {
        int n = cast<int>(strlen(input));
        int state = self.start;
        int pos = 0;
        while (pos < n) {
            if (state == -1) { return 0; }
            state = self.step(state, input[pos]);
            pos = pos + 1;
        }
        if (state == -1) { return 0; }
        if (self.is_final[state] != -1) { return 1; }
        return 0;
    }
}

struct DfaBuilder {
    NFA* nfa;
    DFA* dfa;

    int[128]  subset_len;
    int[16384] subset_states;  /* 128 etats DFA * 128 etats NFA max par sous-ensemble, aplati */

    void init(NFA* n, DFA* d) {
        self.nfa = n;
        self.dfa = d;
    }

    /* Ensemble d'appartenance (taille nfa.state_count) -> liste triee d'ids. */
    int set_to_list(int* set, int* out_list) {
        int n = self.nfa.state_count;
        int i = 0;
        int len = 0;
        while (i < n) {
            if (set[i] == 1) {
                out_list[len] = i;
                len = len + 1;
            }
            i = i + 1;
        }
        return len;
    }

    int list_equals_subset(int* a, int alen, int subset_id) {
        if (alen != self.subset_len[subset_id]) { return 0; }
        int i = 0;
        while (i < alen) {
            if (a[i] != self.subset_states[subset_id * 128 + i]) { return 0; }
            i = i + 1;
        }
        return 1;
    }

    /* Retrouve l'etat DFA correspondant a 'list', ou en cree un nouveau. */
    int find_or_add(int* list, int len) {
        int i = 0;
        while (i < self.dfa.state_count) {
            if (self.list_equals_subset(list, len, i) == 1) {
                return i;
            }
            i = i + 1;
        }
        int id = self.dfa.state_count;
        self.dfa.state_count = id + 1;
        self.subset_len[id] = len;
        int j = 0;
        while (j < len) {
            self.subset_states[id * 128 + j] = list[j];
            j = j + 1;
        }
        int k = 0;
        int best_rule = -1;
        while (k < len) {
            int r = self.nfa.accept_rule[list[k]];
            if (r != -1) {
                if (best_rule == -1 || r < best_rule) { best_rule = r; }
            }
            k = k + 1;
        }
        self.dfa.is_final[id] = best_rule;
        return id;
    }

    void build() {
        int[4096] startset;
        int i = 0;
        while (i < self.nfa.state_count) { startset[i] = 0; i = i + 1; }
        startset[self.nfa.start] = 1;
        self.nfa.eps_closure(&startset);

        int[128] start_list;
        int start_len = self.set_to_list(&startset, &start_list);
        self.dfa.start = self.find_or_add(&start_list, start_len);

        int[128] processed;
        int p = 0;
        while (p < 128) { processed[p] = 0; p = p + 1; }

        int done = 0;
        while (done == 0) {
            int target = -1;
            int t = 0;
            while (t < self.dfa.state_count && target == -1) {
                if (processed[t] == 0) { target = t; }
                t = t + 1;
            }
            if (target == -1) {
                done = 1;
            } else {
                processed[target] = 1;
                int len = self.subset_len[target];

                int octet = 0;
                while (octet < 256) {
                    int[4096] moveset;
                    int mi = 0;
                    while (mi < self.nfa.state_count) { moveset[mi] = 0; mi = mi + 1; }

                    int any_move = 0;
                    int si = 0;
                    while (si < len) {
                        int st = self.subset_states[target * 128 + si];
                        int k = 0;
                        while (k < self.nfa.trans_count) {
                            if (self.nfa.trans_kind[k] != 1 && self.nfa.trans_from[k] == st) {
                                if (self.nfa.trans_accepts(k, cast<char>(octet)) == 1) {
                                    moveset[self.nfa.trans_to[k]] = 1;
                                    any_move = 1;
                                }
                            }
                            k = k + 1;
                        }
                        si = si + 1;
                    }

                    if (any_move == 1) {
                        self.nfa.eps_closure(&moveset);
                        int[128] mlist;
                        int mlen = self.set_to_list(&moveset, &mlist);
                        int tid = self.find_or_add(&mlist, mlen);
                        self.dfa.trans[target * 256 + octet] = tid;
                    }

                    octet = octet + 1;
                }
            }
        }
    }
}

/* ===========================================================
 * MINIMISATION DFA (raffinement de partitions)
 * ===========================================================
 * Partition initiale : un groupe par valeur de is_final DISTINCTE
 * (et non "final vs non-final" comme la minimisation classique) --
 * deux etats acceptant des regles differentes ne doivent jamais
 * fusionner. Puis raffinement iteratif : deux etats du meme groupe
 * sont separes des qu'ils menent, pour un meme octet, vers des
 * groupes differents. On s'arrete quand plus aucun groupe ne se
 * scinde (point fixe).
 * =========================================================== */

struct DfaMinimizer {
    DFA* src;
    int[128] group;
    int group_count;

    void init(DFA* d) {
        self.src = d;
    }

    void minimize() {
        /* partition initiale : par valeur de is_final */
        int[128] seen_val;
        int[128] seen_group;
        int nseen = 0;

        int i = 0;
        while (i < self.src.state_count) {
            int fv = self.src.is_final[i];
            int found = -1;
            int j = 0;
            while (j < nseen) {
                if (seen_val[j] == fv) { found = j; }
                j = j + 1;
            }
            if (found == -1) {
                seen_val[nseen] = fv;
                seen_group[nseen] = nseen;
                found = nseen;
                nseen = nseen + 1;
            }
            self.group[i] = seen_group[found];
            i = i + 1;
        }
        self.group_count = nseen;

        /* raffinement iteratif jusqu'a point fixe */
        int changed = 1;
        while (changed == 1) {
            int[128] new_group;
            int[128] rep_state;
            int rep_count = 0;

            int s = 0;
            while (s < self.src.state_count) {
                int assigned = -1;
                int g = 0;
                while (g < rep_count) {
                    int r = rep_state[g];
                    if (assigned == -1 && self.group[r] == self.group[s]) {
                        int same = 1;
                        int b = 0;
                        while (b < 256) {
                            int ts = self.src.trans[s * 256 + b];
                            int tr = self.src.trans[r * 256 + b];
                            int gts = -1;
                            int gtr = -1;
                            if (ts != -1) { gts = self.group[ts]; }
                            if (tr != -1) { gtr = self.group[tr]; }
                            if (gts != gtr) { same = 0; }
                            b = b + 1;
                        }
                        if (same == 1) { assigned = g; }
                    }
                    g = g + 1;
                }
                if (assigned == -1) {
                    rep_state[rep_count] = s;
                    assigned = rep_count;
                    rep_count = rep_count + 1;
                }
                new_group[s] = assigned;
                s = s + 1;
            }

            if (rep_count != self.group_count) { changed = 1; } else { changed = 0; }
            self.group_count = rep_count;
            int k = 0;
            while (k < self.src.state_count) { self.group[k] = new_group[k]; k = k + 1; }
        }
    }

    /* Construit le DFA minimise dans 'out' a partir du regroupement
       calcule par minimize(). Un seul etat representant par groupe. */
    void build_minimized(DFA* out) {
        out.init();
        out.state_count = self.group_count;

        int[128] rep_of_group;
        int g = 0;
        while (g < self.group_count) {
            int found = -1;
            int s = 0;
            while (s < self.src.state_count) {
                if (found == -1 && self.group[s] == g) { found = s; }
                s = s + 1;
            }
            rep_of_group[g] = found;
            g = g + 1;
        }

        g = 0;
        while (g < self.group_count) {
            int rep = rep_of_group[g];
            out.is_final[g] = self.src.is_final[rep];
            int b = 0;
            while (b < 256) {
                int t = self.src.trans[rep * 256 + b];
                if (t == -1) {
                    out.trans[g * 256 + b] = -1;
                } else {
                    out.trans[g * 256 + b] = self.group[t];
                }
                b = b + 1;
            }
            g = g + 1;
        }

        out.start = self.group[self.src.start];
    }
}

/* ===========================================================
 * SCANNER : maximal munch multi-regles
 * =========================================================== */

struct TokenSpan {
    int rule_id;   /* -2 = erreur lexicale (aucune regle ne matche) */
    int start;     /* index de debut dans le buffer source */
    int len;       /* longueur du lexeme */
}

struct Scanner {
    DFA*  dfa;
    char* src;
    int   pos;
    int   len;

    void init(DFA* d, char* source) {
        self.dfa = d;
        self.src = source;
        self.pos = 0;
        self.len = cast<int>(strlen(source));
    }

    int at_end() {
        return self.pos >= self.len;
    }

    /* Un seul token par maximal munch : avance dans le DFA tant que
       des transitions existent, retient la DERNIERE position ou
       l'automate etait dans un etat acceptant, puis y retombe. */
    TokenSpan next_token() {
        TokenSpan tok;
        tok.start = self.pos;

        int state     = self.dfa.start;
        int best_rule = -1;
        int best_i    = 0;
        int i         = 0;

        while (self.pos + i < self.len) {
            char c = self.src[self.pos + i];
            int nstate = self.dfa.step(state, c);
            if (nstate == -1) { break; }
            state = nstate;
            i = i + 1;
            if (self.dfa.is_final[state] != -1) {
                best_rule = self.dfa.is_final[state];
                best_i    = i;
            }
        }

        if (best_rule == -1) {
            /* Aucune regle n'accepte, meme sur 1 seul caractere :
               erreur lexicale. On avance de 1 pour permettre une
               reprise (comportement standard de recuperation). */
            tok.rule_id = -2;
            tok.len     = 1;
            self.pos    = self.pos + 1;
            return tok;
        }

        tok.rule_id = best_rule;
        tok.len     = best_i;
        self.pos    = self.pos + best_i;
        return tok;
    }

    /* Comme next_token(), mais saute silencieusement les tokens de
       la regle 0 (WHITESPACE par convention dans ce harnais). */
    TokenSpan next_real_token() {
        TokenSpan tok = self.next_token();
        while (tok.rule_id == 0 && self.at_end() == 0) {
            tok = self.next_token();
        }
        return tok;
    }
}

/* ===========================================================
 * SPEC .max : format quasi-conforme flex/JFlex
 * ===========================================================
 * Section de declarations (avant le premier %%) :
 *   %{ ... %}          code MATL-ABC verbatim
 *   %token NOM1 NOM2   declarations de tokens (fonctions generees)
 *   %struct NOM        renomme la struct generee (defaut GenScanner)
 *   %unicode           reconnue, SANS EFFET (moteur octet-par-octet)
 *   %line / %column    reconnues -- le suivi ligne/colonne est de
 *                       toute facon toujours actif dans le code genere
 *   NOM = def_regex        definition nommee, reutilisable via {NOM}
 *                       dans les regles ou definitions ULTERIEURES
 * =========================================================== */

struct RuleFull {
    char[256]  pattern;   /* apres expansion des {NOM} */
    char[1024] action;    /* inclut ses propres accolades { ... } */
}

struct TokenDecl {
    char[32] name;
}

struct Definition {
    char[32]  name;
    char[256] def_regex;      /* deja expansee au moment de sa declaration */
}

struct MaxFile {
    char[2048] prologue_code;
    int        prologue_len;

    TokenDecl[64] tokens;
    int           token_count;

    Definition[32] defs;
    int            def_count;

    RuleFull[64] rules;
    int          rule_count;

    char[4096] epilogue_code;
    int        epilogue_len;

    char[64] struct_name;
    int      line_flag;
    int      column_flag;
    int      unicode_flag;
}

/* Remplace toute reference "{NOM}" dans src[0..src_len) par
   "(regex_de_NOM)" (deja expansee), copie le reste tel quel.
   Fonction independante (pas une methode) car elle n'a besoin que
   de la table de definitions deja construite dans 'out'. */
int expand_refs(char* src, int src_len, char* dst, int dst_cap, MaxFile* out) {
    int i = 0;
    int o = 0;
    while (i < src_len && o < dst_cap - 1) {
        if (src[i] == '{') {
            int ns = i + 1;
            int ne = ns;
            while (ne < src_len && src[ne] != '}') { ne = ne + 1; }
            if (ne < src_len) {
                int name_len = ne - ns;
                int found = -1;
                int di = 0;
                while (di < out.def_count) {
                    int dnl = 0;
                    while (out.defs[di].name[dnl] != cast<char>(0)) { dnl = dnl + 1; }
                    if (dnl == name_len) {
                        int is_match = 1;
                        int k = 0;
                        while (k < name_len) {
                            if (out.defs[di].name[k] != src[ns + k]) { is_match = 0; }
                            k = k + 1;
                        }
                        if (is_match == 1) { found = di; }
                    }
                    di = di + 1;
                }
                if (found != -1) {
                    if (o < dst_cap - 1) { dst[o] = '('; o = o + 1; }
                    int rl = 0;
                    while (out.defs[found].def_regex[rl] != cast<char>(0)) { rl = rl + 1; }
                    int k = 0;
                    while (k < rl && o < dst_cap - 1) { dst[o] = out.defs[found].def_regex[k]; o = o + 1; k = k + 1; }
                    if (o < dst_cap - 1) { dst[o] = ')'; o = o + 1; }
                    i = ne + 1;
                } else {
                    dst[o] = src[i]; o = o + 1; i = i + 1;
                }
            } else {
                dst[o] = src[i]; o = o + 1; i = i + 1;
            }
        } else {
            dst[o] = src[i]; o = o + 1; i = i + 1;
        }
    }
    dst[o] = cast<char>(0);
    return o;
}

/* Reecrit les identifiants JFlex connus (yytext, yylength, yychar,
   yyline, yycolumn, yystate, yybegin, yypushback, yyreset) en
   self.xxx dans une action -- permet a l'utilisateur d'ecrire ses
   actions avec la syntaxe JFlex habituelle (SANS "self.") tout en
   respectant la regle MATL-ABC qui exige un "self." explicite pour
   accéder aux champs/methodes de la struct courante. Conscient des
   chaines/caracteres litteraux (ne reecrit jamais leur contenu). */
int rewrite_action(char* src, int src_len, char* dst, int dst_cap) {
    int i = 0;
    int o = 0;
    while (i < src_len && o < dst_cap - 1) {
        char c = src[i];
        if (c == '"' || c == '\'') {
            char quote = c;
            dst[o] = c; o = o + 1; i = i + 1;
            int closed = 0;
            while (closed == 0 && i < src_len && o < dst_cap - 1) {
                char cc = src[i];
                if (cc == '\\' && i + 1 < src_len) {
                    dst[o] = cc; o = o + 1; i = i + 1;
                    if (o < dst_cap - 1) { dst[o] = src[i]; o = o + 1; }
                    i = i + 1;
                } else {
                    dst[o] = cc; o = o + 1; i = i + 1;
                    if (cc == quote) { closed = 1; }
                }
            }
        } else if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') {
            int ws = i;
            while (i < src_len && ((src[i] >= 'a' && src[i] <= 'z') || (src[i] >= 'A' && src[i] <= 'Z') || (src[i] >= '0' && src[i] <= '9') || src[i] == '_')) {
                i = i + 1;
            }
            int we = i;
            int wlen = we - ws;

            int is_yy = 0;
            if (wlen == 6 && src[ws] == 'y' && src[ws+1] == 'y' && src[ws+2] == 't' && src[ws+3] == 'e' && src[ws+4] == 'x' && src[ws+5] == 't') { is_yy = 1; }
            if (wlen == 8 && src[ws] == 'y' && src[ws+1] == 'y' && src[ws+2] == 'l' && src[ws+3] == 'e' && src[ws+4] == 'n' && src[ws+5] == 'g' && src[ws+6] == 't' && src[ws+7] == 'h') { is_yy = 1; }
            if (wlen == 6 && src[ws] == 'y' && src[ws+1] == 'y' && src[ws+2] == 'c' && src[ws+3] == 'h' && src[ws+4] == 'a' && src[ws+5] == 'r') { is_yy = 1; }
            if (wlen == 6 && src[ws] == 'y' && src[ws+1] == 'y' && src[ws+2] == 'l' && src[ws+3] == 'i' && src[ws+4] == 'n' && src[ws+5] == 'e') { is_yy = 1; }
            if (wlen == 8 && src[ws] == 'y' && src[ws+1] == 'y' && src[ws+2] == 'c' && src[ws+3] == 'o' && src[ws+4] == 'l' && src[ws+5] == 'u' && src[ws+6] == 'm' && src[ws+7] == 'n') { is_yy = 1; }
            if (wlen == 7 && src[ws] == 'y' && src[ws+1] == 'y' && src[ws+2] == 's' && src[ws+3] == 't' && src[ws+4] == 'a' && src[ws+5] == 't' && src[ws+6] == 'e') { is_yy = 1; }
            if (wlen == 7 && src[ws] == 'y' && src[ws+1] == 'y' && src[ws+2] == 'b' && src[ws+3] == 'e' && src[ws+4] == 'g' && src[ws+5] == 'i' && src[ws+6] == 'n') { is_yy = 1; }
            if (wlen == 10 && src[ws] == 'y' && src[ws+1] == 'y' && src[ws+2] == 'p' && src[ws+3] == 'u' && src[ws+4] == 's' && src[ws+5] == 'h' && src[ws+6] == 'b' && src[ws+7] == 'a' && src[ws+8] == 'c' && src[ws+9] == 'k') { is_yy = 1; }
            if (wlen == 7 && src[ws] == 'y' && src[ws+1] == 'y' && src[ws+2] == 'r' && src[ws+3] == 'e' && src[ws+4] == 's' && src[ws+5] == 'e' && src[ws+6] == 't') { is_yy = 1; }

            int already_qualified = 0;
            if (ws > 0 && src[ws - 1] == '.') { already_qualified = 1; }

            if (is_yy == 1 && already_qualified == 0 && o + 5 < dst_cap - 1) {
                dst[o] = 's'; dst[o+1] = 'e'; dst[o+2] = 'l'; dst[o+3] = 'f'; dst[o+4] = '.';
                o = o + 5;
            }
            int k = ws;
            while (k < we && o < dst_cap - 1) { dst[o] = src[k]; o = o + 1; k = k + 1; }
        } else {
            dst[o] = c; o = o + 1; i = i + 1;
        }
    }
    dst[o] = cast<char>(0);
    return o;
}

struct MaxParser {
    char* text;
    int   pos;
    int   len;

    void init(char* spec_text) {
        self.text = spec_text;
        self.pos  = 0;
        self.len  = cast<int>(strlen(spec_text));
    }

    int at_end() {
        return self.pos >= self.len;
    }

    char peek() {
        if (self.at_end()) return cast<char>(0);
        return self.text[self.pos];
    }

    char advance() {
        char c = self.text[self.pos];
        self.pos = self.pos + 1;
        return c;
    }

    int is_inline_ws(char c) {
        return c == ' ' || c == cast<char>(9);
    }

    int is_ws_or_nl(char c) {
        return c == ' ' || c == cast<char>(9) || c == cast<char>(10) || c == cast<char>(13);
    }

    int is_ident_char(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
    }

    int is_ident_start(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
    }

    void copy_prologue_block(MaxFile* out) {
        int copying = 1;
        while (copying == 1) {
            if (self.at_end()) {
                copying = 0;
            } else {
                int bls = self.pos;
                while (!self.at_end() && self.peek() != cast<char>(10)) { self.advance(); }
                int ble = self.pos;
                if (!self.at_end()) { self.advance(); }

                int bts = bls;
                while (bts < ble && self.is_inline_ws(self.text[bts])) { bts = bts + 1; }
                int bte = ble;
                while (bte > bts && self.is_inline_ws(self.text[bte - 1])) { bte = bte - 1; }
                int btlen = bte - bts;

                if (btlen == 2 && self.text[bts] == '%' && self.text[bts + 1] == '}') {
                    copying = 0;
                } else {
                    int i = 0;
                    while (i < (ble - bls) && out.prologue_len < 2047) {
                        out.prologue_code[out.prologue_len] = self.text[bls + i];
                        out.prologue_len = out.prologue_len + 1;
                        i = i + 1;
                    }
                    if (out.prologue_len < 2047) {
                        out.prologue_code[out.prologue_len] = cast<char>(10);
                        out.prologue_len = out.prologue_len + 1;
                    }
                }
            }
        }
    }

    void parse_token_line(MaxFile* out, int p, int te) {
        while (p < te) {
            while (p < te && self.is_inline_ws(self.text[p])) { p = p + 1; }
            int ns = p;
            while (p < te && self.is_inline_ws(self.text[p]) == 0) { p = p + 1; }
            int ne = p;
            if (ne > ns) {
                int tid = out.token_count;
                int nlen = ne - ns;
                if (nlen > 31) { nlen = 31; }
                int i = 0;
                while (i < nlen) { out.tokens[tid].name[i] = self.text[ns + i]; i = i + 1; }
                out.tokens[tid].name[nlen] = cast<char>(0);
                out.token_count = tid + 1;
            }
        }
    }

    /* "%struct NOM" -- p pointe juste apres "%struct". */
    void parse_struct_line(MaxFile* out, int p, int te) {
        while (p < te && self.is_inline_ws(self.text[p])) { p = p + 1; }
        int ns = p;
        while (p < te && self.is_inline_ws(self.text[p]) == 0) { p = p + 1; }
        int ne = p;
        int nlen = ne - ns;
        if (nlen > 0) {
            if (nlen > 63) { nlen = 63; }
            int i = 0;
            while (i < nlen) { out.struct_name[i] = self.text[ns + i]; i = i + 1; }
            out.struct_name[nlen] = cast<char>(0);
        }
    }

    /* Ligne de definition nommee : "NOM = def_regex". ts/te = bornes
       (trim) de la ligne complete. Retourne 1 si la ligne a bien ete
       reconnue comme une definition, 0 sinon (auquel cas l'appelant
       doit essayer une autre interpretation). */
    int try_parse_definition(MaxFile* out, int ts, int te) {
        int p = ts;
        int ns = p;
        while (p < te && self.is_ident_char(self.text[p])) { p = p + 1; }
        int ne = p;
        if (ne == ns) { return 0; }
        while (p < te && self.is_inline_ws(self.text[p])) { p = p + 1; }
        if (p >= te || self.text[p] != '=') { return 0; }
        p = p + 1;
        while (p < te && self.is_inline_ws(self.text[p])) { p = p + 1; }
        int rs = p;
        int re = te;

        int did = out.def_count;
        int nlen = ne - ns;
        if (nlen > 31) { nlen = 31; }
        int i = 0;
        while (i < nlen) { out.defs[did].name[i] = self.text[ns + i]; i = i + 1; }
        out.defs[did].name[nlen] = cast<char>(0);

        char[256] expanded;
        int elen = expand_refs(self.text + rs, re - rs, &expanded, 256, out);
        int j = 0;
        while (j < elen && j < 255) { out.defs[did].def_regex[j] = expanded[j]; j = j + 1; }
        out.defs[did].def_regex[j] = cast<char>(0);

        out.def_count = did + 1;
        return 1;
    }

    void parse_prologue(MaxFile* out) {
        int done = 0;
        while (done == 0) {
            if (self.at_end()) {
                done = 1;
            } else {
                int ls = self.pos;
                while (!self.at_end() && self.peek() != cast<char>(10)) { self.advance(); }
                int le = self.pos;
                if (!self.at_end()) { self.advance(); }

                int ts = ls;
                while (ts < le && self.is_inline_ws(self.text[ts])) { ts = ts + 1; }
                int te = le;
                while (te > ts && self.is_inline_ws(self.text[te - 1])) { te = te - 1; }
                int tlen = te - ts;

                if (tlen == 2 && self.text[ts] == '%' && self.text[ts + 1] == '%') {
                    done = 1;
                } else if (tlen == 2 && self.text[ts] == '%' && self.text[ts + 1] == '{') {
                    self.copy_prologue_block(out);
                } else if (tlen >= 6 && self.text[ts] == '%' && self.text[ts+1] == 't' && self.text[ts+2] == 'o' && self.text[ts+3] == 'k' && self.text[ts+4] == 'e' && self.text[ts+5] == 'n') {
                    self.parse_token_line(out, ts + 6, te);
                } else if (tlen >= 7 && self.text[ts] == '%' && self.text[ts+1] == 's' && self.text[ts+2] == 't' && self.text[ts+3] == 'r' && self.text[ts+4] == 'u' && self.text[ts+5] == 'c' && self.text[ts+6] == 't') {
                    self.parse_struct_line(out, ts + 7, te);
                } else if (tlen == 8 && self.text[ts] == '%' && self.text[ts+1] == 'u' && self.text[ts+2] == 'n' && self.text[ts+3] == 'i' && self.text[ts+4] == 'c' && self.text[ts+5] == 'o' && self.text[ts+6] == 'd' && self.text[ts+7] == 'e') {
                    out.unicode_flag = 1;
                } else if (tlen == 5 && self.text[ts] == '%' && self.text[ts+1] == 'l' && self.text[ts+2] == 'i' && self.text[ts+3] == 'n' && self.text[ts+4] == 'e') {
                    out.line_flag = 1;
                } else if (tlen == 7 && self.text[ts] == '%' && self.text[ts+1] == 'c' && self.text[ts+2] == 'o' && self.text[ts+3] == 'l' && self.text[ts+4] == 'u' && self.text[ts+5] == 'm' && self.text[ts+6] == 'n') {
                    out.column_flag = 1;
                } else if (tlen > 0 && self.text[ts] != '%' && self.is_ident_start(self.text[ts])) {
                    self.try_parse_definition(out, ts, te);
                }
            }
        }
    }

    void parse_rules(MaxFile* out) {
        int done = 0;
        while (done == 0) {
            while (!self.at_end() && self.is_ws_or_nl(self.peek())) { self.advance(); }
            if (self.at_end()) {
                done = 1;
            } else if (self.peek() == '%' && self.pos + 1 < self.len && self.text[self.pos + 1] == '%') {
                self.pos = self.pos + 2;
                done = 1;
            } else {
                int ps = self.pos;
                int scanning_pattern = 1;
                while (scanning_pattern == 1) {
                    if (self.at_end()) {
                        scanning_pattern = 0;
                    } else if (self.peek() == '{') {
                        int save = self.pos;
                        self.advance();
                        int ns = self.pos;
                        while (!self.at_end() && self.is_ident_char(self.peek())) { self.advance(); }
                        int ne = self.pos;
                        if (!self.at_end() && self.peek() == '}' && ne > ns) {
                            self.advance();
                        } else {
                            self.pos = save;
                            scanning_pattern = 0;
                        }
                    } else {
                        self.advance();
                    }
                }
                int pe = self.pos;
                while (pe > ps && self.is_ws_or_nl(self.text[pe - 1])) { pe = pe - 1; }

                if (self.at_end()) {
                    done = 1;
                } else {
                    int as_ = self.pos;
                    int depth = 0;
                    int in_str = 0;
                    int in_chr = 0;
                    int scanning = 1;
                    while (scanning == 1) {
                        if (self.at_end()) {
                            scanning = 0;
                        } else {
                            char c = self.advance();
                            if (in_str == 1) {
                                if (c == '\\' && !self.at_end()) { self.advance(); }
                                else if (c == '"') { in_str = 0; }
                            } else if (in_chr == 1) {
                                if (c == '\\' && !self.at_end()) { self.advance(); }
                                else if (c == '\'') { in_chr = 0; }
                            } else {
                                if (c == '"') { in_str = 1; }
                                else if (c == '\'') { in_chr = 1; }
                                else if (c == '{') { depth = depth + 1; }
                                else if (c == '}') {
                                    depth = depth - 1;
                                    if (depth == 0) { scanning = 0; }
                                }
                            }
                        }
                    }
                    int ae = self.pos;

                    int rid = out.rule_count;

                    char[256] expanded_pattern;
                    int plen = expand_refs(self.text + ps, pe - ps, &expanded_pattern, 256, out);
                    int i = 0;
                    while (i < plen && i < 255) { out.rules[rid].pattern[i] = expanded_pattern[i]; i = i + 1; }
                    out.rules[rid].pattern[i] = cast<char>(0);

                    int alen = ae - as_;
                    if (alen > 1023) { alen = 1023; }
                    i = 0;
                    while (i < alen) { out.rules[rid].action[i] = self.text[as_ + i]; i = i + 1; }
                    out.rules[rid].action[alen] = cast<char>(0);

                    out.rule_count = rid + 1;
                }
            }
        }
    }

    void parse_epilogue(MaxFile* out) {
        int es = self.pos;
        while (!self.at_end()) { self.advance(); }
        int elen = self.pos - es;
        if (elen > 4095) { elen = 4095; }
        int i = 0;
        while (i < elen) { out.epilogue_code[i] = self.text[es + i]; i = i + 1; }
        out.epilogue_code[elen] = cast<char>(0);
        out.epilogue_len = elen;
    }

    void parse(MaxFile* out) {
        out.prologue_len  = 0;
        out.token_count   = 0;
        out.def_count     = 0;
        out.rule_count    = 0;
        out.epilogue_len  = 0;
        out.line_flag     = 0;
        out.column_flag   = 0;
        out.unicode_flag  = 0;
        out.struct_name[0] = cast<char>(0);

        self.parse_prologue(out);
        self.parse_rules(out);
        self.parse_epilogue(out);

        if (out.struct_name[0] == cast<char>(0)) {
            str dflt = "GenScanner";
            char* d = dflt.data();
            int i = 0;
            while (d[i] != cast<char>(0)) { out.struct_name[i] = d[i]; i = i + 1; }
            out.struct_name[i] = cast<char>(0);
        }
    }

    /* Compile toutes les regles de la spec dans un NFA combine. */
    void build_nfa(MaxFile* spec, NFA* nfa) {
        nfa.init();
        nfa.start = nfa.new_state();

        RegexParser p;
        int i = 0;
        while (i < spec.rule_count) {
            p.init(&spec.rules[i].pattern, nfa);
            p.compile_rule(i);
            i = i + 1;
        }
    }
}

/* ===========================================================
 * LECTURE DE FICHIER (utilisee par matlex lui-meme pour lire la
 * spec .max, ET regeneree dans le driver du scanner produit)
 * =========================================================== */
int read_whole_file(char* path, char* buf, int cap) {
    char* mode = "r";
    char* f = fopen(path, mode);
    if (f == null) { return -1; }

    int off = 0;
    char* got = fgets(buf + off, cap - off, f);
    while (got != null) {
        off = off + cast<int>(strlen(buf + off));
        if (cap - off < 2) {
            got = null;
        } else {
            got = fgets(buf + off, cap - off, f);
        }
    }
    fclose(f);
    buf[off] = cast<char>(0);
    return off;
}

/* ===========================================================
 * GENERATION DE CODE : scanner MATL-ABC autonome, API JFlex
 * ===========================================================
 * Comme au round 5, chaque regle execute son VRAI code d'action.
 * Nouveau : API complete self.yytext()/self.yylength()/self.yychar()/
 * self.yyline/self.yycolumn/self.yybegin()/self.yystate()/
 * self.yypushback()/self.yyreset() -- injectee automatiquement dans
 * les actions par rewrite_action() (l'utilisateur ecrit "yytext()",
 * pas "self.yytext()", exactement comme en JFlex).
 * =========================================================== */
void gen_scanner_v3(DFA* dfa, MaxFile* spec, char* demo_source) {
    printf("/* =====================================================\n");
    printf(" * Scanner genere automatiquement par matlex (round 6, .max)\n");
    printf(" * NE PAS EDITER A LA MAIN -- regenerer depuis la spec .max\n");
    printf(" * ===================================================== */\n\n");
    printf("import <cstd>\n");
    printf("import <cstring>\n\n");

    if (spec.prologue_len > 0) {
        printf("/* ---- prologue (%%{ ... %%}) ---- */\n");
        printf("%s\n", &spec.prologue_code);
    }

    if (spec.token_count > 0) {
        printf("/* ---- constantes de token (%%token), via #define ---- */\n");
        int ti = 0;
        while (ti < spec.token_count) {
            printf("#define %s %d\n", &spec.tokens[ti].name, ti);
            ti = ti + 1;
        }
        print("\n");
    }

    printf("struct %s {\n", &spec.struct_name);
    printf("    char* src;\n    int pos;\n    int len;\n");
    printf("    int[%d] trans;\n", dfa.state_count * 256);
    printf("    int[%d] is_final;\n", dfa.state_count);
    printf("    char[256] yytext_buf;\n    int yyleng_val;\n");
    printf("    int yychar_val;\n    int yyline;\n    int yycolumn;\n");
    printf("    int lex_state;\n\n");

    printf("    void init(char* source) {\n");
    printf("        self.src = source;\n        self.pos = 0;\n        self.len = cast<int>(strlen(source));\n");
    printf("        self.yychar_val = 0;\n        self.yyline = 0;\n        self.yycolumn = 0;\n        self.lex_state = 0;\n");
    printf("        int i = 0;\n        while (i < %d) { self.trans[i] = -1; i = i + 1; }\n", dfa.state_count * 256);
    int s = 0;
    while (s < dfa.state_count) {
        int b = 0;
        while (b < 256) {
            int t = dfa.trans[s * 256 + b];
            if (t != -1) {
                printf("        self.trans[%d] = %d;\n", s * 256 + b, t);
            }
            b = b + 1;
        }
        s = s + 1;
    }
    s = 0;
    while (s < dfa.state_count) {
        printf("        self.is_final[%d] = %d;\n", s, dfa.is_final[s]);
        s = s + 1;
    }
    printf("    }\n\n");

    printf("    int at_end() { return self.pos >= self.len; }\n\n");

    printf("    int step(int state, char c) {\n");
    printf("        int b = cast<int>(c);\n        if (b < 0) { return -1; }\n");
    printf("        return self.trans[state * 256 + b];\n");
    printf("    }\n\n");

    printf("    /* API JFlex -- champs/methodes exposes a l'utilisateur */\n");
    printf("    str yytext() { return &self.yytext_buf; }\n");
    printf("    int yylength() { return self.yyleng_val; }\n");
    printf("    int yychar() { return self.yychar_val; }\n");
    printf("    int yystate() { return self.lex_state; }\n");
    printf("    void yybegin(int s) { self.lex_state = s; }\n");
    printf("    void yypushback(int n) {\n");
    printf("        self.pos = self.pos - n;\n");
    printf("        if (self.pos < 0) { self.pos = 0; }\n");
    printf("    }\n");
    printf("    void yyreset(char* new_source) {\n");
    printf("        self.init(new_source);\n");
    printf("    }\n\n");

    printf("    /* Avance yyline/yycolumn de n caracteres a partir de self.pos. */\n");
    printf("    void advance_line_col(int n) {\n");
    printf("        int i = 0;\n");
    printf("        while (i < n) {\n");
    printf("            char c = self.src[self.pos + i];\n");
    printf("            if (c == cast<char>(10)) { self.yyline = self.yyline + 1; self.yycolumn = 0; }\n");
    printf("            else { self.yycolumn = self.yycolumn + 1; }\n");
    printf("            i = i + 1;\n");
    printf("        }\n");
    printf("    }\n\n");

    printf("    /* Une passe de maximal munch ; remplit yytext_buf/yyleng_val.\n");
    printf("       Retourne l'id de regle gagnante, ou -1 si aucune regle\n");
    printf("       n'accepte (erreur lexicale -- 1 caractere consomme). */\n");
    printf("    int scan_one() {\n");
    printf("        self.yychar_val = self.pos;\n");
    printf("        int state = %d;\n", dfa.start);
    printf("        int best_rule = -1;\n        int best_i = 0;\n        int i = 0;\n");
    printf("        while (self.pos + i < self.len) {\n");
    printf("            char c = self.src[self.pos + i];\n");
    printf("            int nstate = self.step(state, c);\n");
    printf("            if (nstate == -1) { break; }\n");
    printf("            state = nstate;\n            i = i + 1;\n");
    printf("            if (self.is_final[state] != -1) { best_rule = self.is_final[state]; best_i = i; }\n");
    printf("        }\n");
    printf("        if (best_rule == -1) {\n");
    printf("            self.yyleng_val = 1;\n");
    printf("            self.yytext_buf[0] = self.src[self.pos];\n");
    printf("            self.yytext_buf[1] = cast<char>(0);\n");
    printf("            self.advance_line_col(1);\n");
    printf("            self.pos = self.pos + 1;\n");
    printf("            return -1;\n");
    printf("        }\n");
    printf("        self.yyleng_val = best_i;\n");
    printf("        int k = 0;\n        while (k < best_i && k < 255) { self.yytext_buf[k] = self.src[self.pos + k]; k = k + 1; }\n");
    printf("        self.yytext_buf[k] = cast<char>(0);\n");
    printf("        self.advance_line_col(best_i);\n");
    printf("        self.pos = self.pos + best_i;\n");
    printf("        return best_rule;\n");
    printf("    }\n\n");

    printf("    /* yylex() : boucle de scan style flex/JFlex. -1 = fin d'entree. */\n");
    printf("    int yylex() {\n");
    printf("        int cont = 1;\n        int result = -1;\n");
    printf("        while (cont == 1) {\n");
    printf("            if (self.at_end()) {\n");
    printf("                cont = 0;\n");
    printf("            } else {\n");
    printf("                int rid = self.scan_one();\n");
    printf("                if (rid == -1) {\n");
    printf("                    int lex_err = 1;\n");

    int ri = 0;
    while (ri < spec.rule_count) {
        char[1200] rewritten;
        int alen = 0;
        while (spec.rules[ri].action[alen] != cast<char>(0)) { alen = alen + 1; }
        int rlen = rewrite_action(&spec.rules[ri].action, alen, &rewritten, 1200);
        if (ri == 0) {
            printf("                } else if (rid == %d) %s\n", ri, &rewritten);
        } else {
            printf("                else if (rid == %d) %s\n", ri, &rewritten);
        }
        ri = ri + 1;
    }
    if (spec.rule_count == 0) {
        printf("                }\n");
    }
    printf("            }\n");
    printf("        }\n");
    printf("        return result;\n");
    printf("    }\n");
    printf("}\n\n");

    int has_epilogue_code = 0;
    int eci = 0;
    while (eci < spec.epilogue_len) {
        char ec = spec.epilogue_code[eci];
        if (ec != ' ' && ec != cast<char>(9) && ec != cast<char>(10) && ec != cast<char>(13)) {
            has_epilogue_code = 1;
        }
        eci = eci + 1;
    }

    if (has_epilogue_code == 1) {
        printf("/* ---- code utilisateur final (apres le 2e %%%%) ---- */\n");
        printf("%s\n", &spec.epilogue_code);
    } else {
        printf("int read_whole_file(char* path, char* buf, int cap) {\n");
        printf("    char* mode = \"r\";\n");
        printf("    char* f = fopen(path, mode);\n");
        printf("    if (f == null) { return -1; }\n");
        printf("    int off = 0;\n");
        printf("    char* got = fgets(buf + off, cap - off, f);\n");
        printf("    while (got != null) {\n");
        printf("        off = off + cast<int>(strlen(buf + off));\n");
        printf("        if (cap - off < 2) { got = null; } else { got = fgets(buf + off, cap - off, f); }\n");
        printf("    }\n");
        printf("    fclose(f);\n");
        printf("    buf[off] = cast<char>(0);\n");
        printf("    return off;\n");
        printf("}\n\n");
        printf("int main(int argc, char** argv) {\n");
        printf("    char[65536] buf;\n    int off = 0;\n\n");
        printf("    if (argc > 1) {\n");
        printf("        int n = read_whole_file(argv[1], &buf, 65536);\n");
        printf("        if (n < 0) { printf(\"Erreur : impossible de lire '%%s'\\n\", argv[1]); return 1; }\n");
        printf("    } else {\n");
        printf("        int done = 0;\n");
        printf("        while (done == 0) {\n");
        printf("            char[1024] line;\n            int lp = 0;\n");
        printf("            int c = getchar();\n");
        printf("            while (c != -1 && cast<char>(c) != cast<char>(10) && lp < 1023) { line[lp] = cast<char>(c); lp = lp + 1; c = getchar(); }\n");
        printf("            line[lp] = cast<char>(0);\n");
        printf("            if (c == -1 && lp == 0) { done = 1; }\n");
        printf("            else if (lp == 3 && line[0] == 'E' && line[1] == 'O' && line[2] == 'F') { done = 1; }\n");
        printf("            else {\n");
        printf("                int i = 0;\n                while (i < lp && off < 65535) { buf[off] = line[i]; off = off + 1; i = i + 1; }\n");
        printf("                if (off < 65535) { buf[off] = cast<char>(10); off = off + 1; }\n");
        printf("                if (c == -1) { done = 1; }\n");
        printf("            }\n");
        printf("        }\n");
        printf("        buf[off] = cast<char>(0);\n");
        printf("    }\n\n");
        printf("    %s sc;\n    sc.init(&buf);\n\n", &spec.struct_name);
        printf("    int tok = sc.yylex();\n");
        printf("    while (tok != -1) {\n");
        printf("        printf(\"token = %%d  (yytext = '%%s', ligne %%d, colonne %%d)\\n\", tok, sc.yytext().data(), sc.yyline, sc.yycolumn);\n");
        printf("        tok = sc.yylex();\n");
        printf("    }\n");
        printf("    return 0;\n");
        printf("}\n");
    }
}

/* ===========================================================
 * FICHIER INTERMEDIAIRE DE TOKENS (pour matyacc)
 * =========================================================== */
void gen_tokens_file(MaxFile* spec) {
    printf("# Fichier de tokens genere par matlex (round 6) -- pour matyacc\n");
    int i = 0;
    while (i < spec.token_count) {
        printf("%s %d\n", &spec.tokens[i].name, i);
        i = i + 1;
    }
}

str default_demo_max_spec() {
    return "%{\n/* prologue de demonstration */\n%}\n\n%token TOK_IDENT TOK_INT\n\nLETTRE = [a-zA-Z_]\nCHIFFRE = [0-9]\nID = {LETTRE}({LETTRE}|{CHIFFRE})*\n\n%%\n[ \t\n\r]+ { int skip = 0; }\n{ID} { return TOK_IDENT; }\n{CHIFFRE}+ { return TOK_INT; }\n%%\n";
}

int main(int argc, char** argv) {
    char[65536] spec_buf;
    str spec_text;

    if (argc > 1) {
        int n = read_whole_file(argv[1], &spec_buf, 65536);
        if (n < 0) {
            printf("Erreur : impossible de lire '%s'\n", argv[1]);
            return 1;
        }
        spec_text = &spec_buf;
    } else {
        spec_text = default_demo_max_spec();
    }

    MaxFile spec;
    MaxParser mp;
    mp.init(spec_text.data());
    mp.parse(&spec);

    printf("=== matlex Round 6 : spec .max analysee ===\n");
    printf("  struct    : %s\n", &spec.struct_name);
    printf("  prologue  : %d octet(s)\n", spec.prologue_len);
    printf("  tokens    : %d declare(s)\n", spec.token_count);
    printf("  definitions : %d\n", spec.def_count);
    int di = 0;
    while (di < spec.def_count) {
        printf("    %s = %s\n", &spec.defs[di].name, &spec.defs[di].def_regex);
        di = di + 1;
    }
    printf("  regles    : %d\n", spec.rule_count);
    int rii = 0;
    while (rii < spec.rule_count) {
        printf("    regle %2d : /%s/\n", rii, &spec.rules[rii].pattern);
        rii = rii + 1;
    }
    printf("  epilogue  : %d octet(s)\n\n", spec.epilogue_len);

    NFA nfa;
    mp.build_nfa(&spec, &nfa);

    DFA dfa;
    dfa.init();
    DfaBuilder b;
    b.init(&nfa, &dfa);
    b.build();

    DfaMinimizer m;
    m.init(&dfa);
    m.minimize();
    DFA dfa_min;
    m.build_minimized(&dfa_min);

    printf("=== GENERATED SCANNER START ===\n");
    gen_scanner_v3(&dfa_min, &spec, "demo");
    printf("=== GENERATED SCANNER END ===\n");

    printf("=== GENERATED TOKENS START ===\n");
    gen_tokens_file(&spec);
    printf("=== GENERATED TOKENS END ===\n");

    return 0;
}
