        self.trans[5496] = 10;
        self.trans[5497] = 10;
        self.trans[5498] = 10;
        self.is_final[0] = -1;
        self.is_final[1] = 12;
        self.is_final[2] = 0;
        self.is_final[3] = 8;
        self.is_final[4] = 6;
        self.is_final[5] = 7;
        self.is_final[6] = 9;
        self.is_final[7] = 4;
        self.is_final[8] = 11;
        self.is_final[9] = 10;
        self.is_final[10] = 5;
        self.is_final[11] = 5;
        self.is_final[12] = 5;
        self.is_final[13] = 5;
        self.is_final[14] = 5;
        self.is_final[15] = 1;
        self.is_final[16] = 5;
        self.is_final[17] = 5;
        self.is_final[18] = 5;
        self.is_final[19] = 2;
        self.is_final[20] = 5;
        self.is_final[21] = 3;
    }

    int at_end() { return self.pos >= self.len; }

    int step(int state, char c) {
        int b = cast<int>(c);
        if (b < 0) { return -1; }
        return self.trans[state * 256 + b];
    }

    /* API JFlex -- champs/methodes exposes a l'utilisateur */
    str yytext() { return &self.yytext_buf; }
    int yylength() { return self.yyleng_val; }
    int yychar() { return self.yychar_val; }
    int yystate() { return self.lex_state; }
    void yybegin(int s) { self.lex_state = s; }
    void yypushback(int n) {
        self.pos = self.pos - n;
        if (self.pos < 0) { self.pos = 0; }
    }
    void yyreset(char* new_source) {
        self.init(new_source);
    }

    /* Avance yyline/yycolumn de n caracteres a partir de self.pos. */
    void advance_line_col(int n) {
        int i = 0;
        while (i < n) {
            char c = self.src[self.pos + i];
            if (c == cast<char>(10)) { self.yyline = self.yyline + 1; self.yycolumn = 0; }
            else { self.yycolumn = self.yycolumn + 1; }
            i = i + 1;
        }
    }

    /* Une passe de maximal munch ; remplit yytext_buf/yyleng_val.
       Retourne l'id de regle gagnante, ou -1 si aucune regle
       n'accepte (erreur lexicale -- 1 caractere consomme). */
    int scan_one() {
        self.yychar_val = self.pos;
        int state = 0;
        int best_rule = -1;
        int best_i = 0;
        int i = 0;
        while (self.pos + i < self.len) {
            char c = self.src[self.pos + i];
            int nstate = self.step(state, c);
            if (nstate == -1) { break; }
            state = nstate;
            i = i + 1;
            if (self.is_final[state] != -1) { best_rule = self.is_final[state]; best_i = i; }
        }
        if (best_rule == -1) {
            self.yyleng_val = 1;
            self.yytext_buf[0] = self.src[self.pos];
            self.yytext_buf[1] = cast<char>(0);
            self.advance_line_col(1);
            self.pos = self.pos + 1;
            return -1;
        }
        self.yyleng_val = best_i;
        int k = 0;
        while (k < best_i && k < 255) { self.yytext_buf[k] = self.src[self.pos + k]; k = k + 1; }
        self.yytext_buf[k] = cast<char>(0);
        self.advance_line_col(best_i);
        self.pos = self.pos + best_i;
        return best_rule;
    }

    /* ---- prologue utilisateur (%{ ... %}), methodes ---- */
/* ---------------------------------------------------------------
 * Methodes utilitaires : construisent un Symbol (type + position
 * + valeur semantique optionnelle), a la maniere de symbol()/
 * symbolObject() dans un lexer JFlex classique. Injectees comme
 * methodes du scanner genere -- yyline/yycolumn/yytext() sont donc
 * directement accessibles ici (matlex les reecrit en self.xxx).
 *
 * Les entiers de type de token (0, 1, 2, ...) sont pour l'instant
 * des constantes brutes : dans un pipeline complet, elles viendraient
 * du module "sym" genere par matyacc (comme sym.IF, sym.PLUS, ... en
 * JFlex/CUP) -- matlex ne connait pas ces noms, seulement matyacc.
 * --------------------------------------------------------------- */
Symbol symbol(int t) {
    Symbol s;
    s.sym_type = t;
    s.line = self.yyline;
    s.column = self.yycolumn;
    s.ivalue = 0;
    return s;
}

Symbol symbolInt(int t, int v) {
    Symbol s;
    s.sym_type = t;
    s.line = self.yyline;
    s.column = self.yycolumn;
    s.ivalue = v;
    return s;
}

Symbol symbolStr(int t, str v) {
    Symbol s;
    s.sym_type = t;
    s.line = self.yyline;
    s.column = self.yycolumn;
    s.svalue = v;
    return s;
}

    /* yylex() : boucle de scan style flex/JFlex.
       Symbol.sym_type == -1 signale la fin d'entree. */
    Symbol yylex() {
        int cont = 1;
        Symbol result;
        result.sym_type = -1;
        result.line = self.yyline;
        result.column = self.yycolumn;
        result.ivalue = 0;
        while (cont == 1) {
            if (self.at_end()) {
                cont = 0;
            } else {
                int rid = self.scan_one();
                if (rid == -1) {
                    int lex_err = 1;
                } else if (rid == 0) { int skip = 0; }
                else if (rid == 1) { return self.symbol(10); }
                else if (rid == 2) { return self.symbol(11); }
                else if (rid == 3) { return self.symbol(12); }
                else if (rid == 4) { return self.symbolInt(1, atoi(self.yytext().data())); }
                else if (rid == 5) { return self.symbolStr(0, self.yytext()); }
                else if (rid == 6) { return self.symbol(20); }
                else if (rid == 7) { return self.symbol(21); }
                else if (rid == 8) { return self.symbol(22); }
                else if (rid == 9) { return self.symbol(23); }
                else if (rid == 10) { return self.symbol(24); }
                else if (rid == 11) { return self.symbol(25); }
                else if (rid == 12) {
                 printf("Caractere inconnu : '%s' ligne %d colonne %d\n",
                        self.yytext().data(), self.yyline + 1, self.yycolumn + 1);
             }
            }
        }
        return result;
    }
}

/* ---- code utilisateur final (apres le 2e %%), typiquement main() ---- */


/* ---------------------------------------------------------------
 * Programme de demonstration : tokenise l'entree (fichier en
 * argv[1], sinon stdin -- sentinelle "EOF" sur sa propre ligne, ou
 * fin de flux normale) et affiche chaque Symbol produit.
 * --------------------------------------------------------------- */
int read_whole_file(char* path, char* buf, int cap) {
    char* mode = "r";
    char* f = fopen(path, mode);
    if (f == null) { return -1; }
    int off = 0;
    char* got = fgets(buf + off, cap - off, f);
    while (got != null) {
        off = off + cast<int>(strlen(buf + off));
        if (cap - off < 2) { got = null; } else { got = fgets(buf + off, cap - off, f); }
    }
    fclose(f);
    buf[off] = cast<char>(0);
    return off;
}

int main(int argc, char** argv) {
    char[65536] buf;
    int off = 0;

    if (argc > 1) {
        int n = read_whole_file(argv[1], &buf, 65536);
        if (n < 0) {
            printf("Erreur : impossible de lire '%s'\n", argv[1]);
            return 1;
        }
    } else {
        int done = 0;
        while (done == 0) {
            char[1024] line;
            int lp = 0;
            int c = getchar();
            while (c != -1 && cast<char>(c) != cast<char>(10) && lp < 1023) {
                line[lp] = cast<char>(c);
                lp = lp + 1;
                c = getchar();
            }
            line[lp] = cast<char>(0);
            if (c == -1 && lp == 0) {
                done = 1;
            } else if (lp == 3 && line[0] == 'E' && line[1] == 'O' && line[2] == 'F') {
                done = 1;
            } else {
                int i = 0;
                while (i < lp && off < 65535) { buf[off] = line[i]; off = off + 1; i = i + 1; }
                if (off < 65535) { buf[off] = cast<char>(10); off = off + 1; }
                if (c == -1) { done = 1; }
            }
        }
        buf[off] = cast<char>(0);
    }

    GenScanner sc;
    sc.init(&buf);

    printf("=== MiniCalc3 : tokenisation avec Symbol ===\n\n");

    Symbol tok = sc.yylex();
    while (tok.sym_type != -1) {
        if (tok.sym_type == 0) {
            printf("  IDENT   svalue='%s'  ligne %d colonne %d\n", tok.svalue.data(), tok.line, tok.column);
        } else if (tok.sym_type == 1) {
            printf("  ENTIER  ivalue=%d    ligne %d colonne %d\n", tok.ivalue, tok.line, tok.column);
        } else {
            printf("  SYMBOLE type=%-2d              ligne %d colonne %d\n", tok.sym_type, tok.line, tok.column);
        }
        tok = sc.yylex();
    }

    printf("\n=== fin ===\n");
    return 0;
}

