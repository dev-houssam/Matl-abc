        self.is_final[0] = -1;
        self.is_final[1] = 0;
        self.is_final[2] = 8;
        self.is_final[3] = 9;
        self.is_final[4] = 6;
        self.is_final[5] = 4;
        self.is_final[6] = 5;
        self.is_final[7] = 7;
        self.is_final[8] = 3;
        self.is_final[9] = 11;
        self.is_final[10] = 10;
        self.is_final[11] = 1;
        self.is_final[12] = -1;
        self.is_final[13] = 2;
    }

    int at_end() { return self.pos >= self.len; }

    int step(int state, char c) {
        int b = cast<int>(c);
        if (b < 0) { return -1; }
        return self.trans[state * 256 + b];
    }

    /* Une passe de maximal munch ; remplit yytext_buf/yyleng.
       Retourne l'id de regle gagnante, ou -1 si aucune regle
       n'accepte (erreur lexicale -- 1 caractere consomme). */
    int scan_one() {
        int state = 0;
        int best_rule = -1;
        int best_i = 0;
        int i = 0;
        while (self.pos + i < self.len) {
            char c = self.src[self.pos + i];
            int nstate = self.step(state, c);
            if (nstate == -1) { break; }
            state = nstate;
            i = i + 1;
            if (self.is_final[state] != -1) { best_rule = self.is_final[state]; best_i = i; }
        }
        if (best_rule == -1) {
            self.yyleng = 1;
            self.yytext_buf[0] = self.src[self.pos];
            self.yytext_buf[1] = cast<char>(0);
            self.pos = self.pos + 1;
            return -1;
        }
        self.yyleng = best_i;
        int k = 0;
        while (k < best_i && k < 255) { self.yytext_buf[k] = self.src[self.pos + k]; k = k + 1; }
        self.yytext_buf[k] = cast<char>(0);
        self.pos = self.pos + best_i;
        return best_rule;
    }

    /* yylex() : boucle de scan style flex. -1 = fin d'entree. */
    int yylex() {
        int cont = 1;
        int result = -1;
        while (cont == 1) {
            if (self.at_end()) {
                cont = 0;
            } else {
                char* yytext = &self.yytext_buf;
                int rid = self.scan_one();
                int yyleng = self.yyleng;
                if (rid == -1) {
                    /* erreur lexicale : ignoree, reprise au caractere suivant */
                    int lex_err = 1;
                } else if (rid == 0) { int skip = 0; }
                else if (rid == 1) { return TOK_IDENT(); }
                else if (rid == 2) { return TOK_FLOAT(); }
                else if (rid == 3) { return TOK_INT(); }
                else if (rid == 4) { return TOK_PLUS(); }
                else if (rid == 5) { return TOK_MINUS(); }
                else if (rid == 6) { return TOK_STAR(); }
                else if (rid == 7) { return TOK_SLASH(); }
                else if (rid == 8) { return TOK_LPAREN(); }
                else if (rid == 9) { return TOK_RPAREN(); }
                else if (rid == 10) { return TOK_ASSIGN(); }
                else if (rid == 11) { return TOK_SEMI(); }
            }
        }
        return result;
    }
}

int read_whole_file(char* path, char* buf, int cap) {
    char* mode = "r";
    char* f = fopen(path, mode);
    if (f == null) { return -1; }
    int off = 0;
    char* got = fgets(buf + off, cap - off, f);
    while (got != null) {
        off = off + cast<int>(strlen(buf + off));
        if (cap - off < 2) { got = null; } else { got = fgets(buf + off, cap - off, f); }
    }
    fclose(f);
    buf[off] = cast<char>(0);
    return off;
}

int main(int argc, char** argv) {
    char[65536] buf;
    int off = 0;

    if (argc > 1) {
        int n = read_whole_file(argv[1], &buf, 65536);
        if (n < 0) { printf("Erreur : impossible de lire '%s'\n", argv[1]); return 1; }
    } else {
        int done = 0;
        while (done == 0) {
            char[1024] line;
            int lp = 0;
            int c = getchar();
            while (c != -1 && cast<char>(c) != cast<char>(10) && lp < 1023) { line[lp] = cast<char>(c); lp = lp + 1; c = getchar(); }
            line[lp] = cast<char>(0);
            if (c == -1 && lp == 0) { done = 1; }
            else if (lp == 3 && line[0] == 'E' && line[1] == 'O' && line[2] == 'F') { done = 1; }
            else {
                int i = 0;
                while (i < lp && off < 65535) { buf[off] = line[i]; off = off + 1; i = i + 1; }
                if (off < 65535) { buf[off] = cast<char>(10); off = off + 1; }
                if (c == -1) { done = 1; }
            }
        }
        buf[off] = cast<char>(0);
    }

    GenScanner sc;
    sc.init(&buf);

    int tok = sc.yylex();
    while (tok != -1) {
        printf("token = %d  (yytext = '%s')\n", tok, &sc.yytext_buf);
        tok = sc.yylex();
    }
    return 0;
}
