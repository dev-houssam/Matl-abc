/* ---- constantes de token (%token), exposees comme fonctions ---- */
int TOK_IDENT() { return 0; }
int TOK_INT() { return 1; }
int TOK_FLOAT() { return 2; }
int TOK_PLUS() { return 3; }
int TOK_MINUS() { return 4; }
int TOK_STAR() { return 5; }
int TOK_SLASH() { return 6; }
int TOK_LPAREN() { return 7; }
int TOK_RPAREN() { return 8; }
int TOK_ASSIGN() { return 9; }
int TOK_SEMI() { return 10; }
