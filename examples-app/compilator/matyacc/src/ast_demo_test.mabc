/* =====================================================
 * Parseur genere automatiquement par matyacc (round 5, .may)
 * Style JCUP -- NE PAS EDITER A LA MAIN
 * ===================================================== */

import <cstd>
import <cstring>

/* ---- constantes de token, comme le module 'sym' de CUP ---- */
enum sym { PLUS, STAR, NUM }

/* ---- struct/enum declares dans "parser code { }" -- hisses
   au niveau racine (une declaration de type ne peut pas etre
   imbriquee dans une autre struct en MATL-ABC) ---- */
struct Node {
        int   op;      /* 0 = feuille (nombre), 1 = addition, 2 = multiplication */
        int   value;
        Node* left;
        Node* right;

        void init(int o, int v, Node* l, Node* r) {
            self.op = o;
            self.value = v;
            self.left = l;
            self.right = r;
        }
    }

/* SemVal : valeur semantique 'personnalisable' -- int, str,
   ou pointeur generique (struct/tableau/pile/arbre/...). */
struct Symbol { int sym_type; int line; int column; int ivalue; str svalue; }
struct GenScanner { int dummy; Symbol yylex() { Symbol s; s.sym_type = -1; return s; } }

struct SemVal {
    int  kind;
    int  ival;
    str  sval;
    rawptr pval;
}

struct GenParser {
    int[224] action_tbl;
    int[224] goto_tbl;
    int[128] sstack;
    int sp;
    SemVal[128] vstack;
    int vsp;

    void init() {
        int i = 0;
        while (i < 224) { self.action_tbl[i] = 0; self.goto_tbl[i] = -1; i = i + 1; }
        self.action_tbl[2] = 2;
        self.goto_tbl[4] = 2;
        self.action_tbl[32] = -4;
        self.action_tbl[33] = -4;
        self.action_tbl[35] = -4;
        self.action_tbl[64] = 4;
        self.action_tbl[65] = 5;
        self.action_tbl[67] = -999999;
        self.action_tbl[98] = 2;
        self.goto_tbl[100] = 5;
        self.action_tbl[130] = 2;
        self.goto_tbl[132] = 6;
        self.action_tbl[160] = -2;
        self.action_tbl[161] = 5;
        self.action_tbl[163] = -2;
        self.action_tbl[192] = -3;
        self.action_tbl[193] = -3;
        self.action_tbl[195] = -3;
    }

    /* ---- parser code { ... }, methodes ---- */

    

    int eval_node(Node* n) {
        if (n.op == 0) { return n.value; }
        if (n.op == 1) { return self.eval_node(n.left) + self.eval_node(n.right); }
        return self.eval_node(n.left) * self.eval_node(n.right);
    }

    void print_node(Node* n) {
        if (n.op == 0) {
            printf("%d", n.value);
        } else {
            char op_char = '+';
            if (n.op == 2) { op_char = '*'; }
            printf("(");
            self.print_node(n.left);
            printf(" %c ", op_char);
            self.print_node(n.right);
            printf(")");
        }
    }

    /* Dispatch de reduction commun (appele par parse() et
       parse_with_scanner()) : execute l'action de la regle,
       depile, calcule le GOTO, empile le resultat. */
    void do_reduce(int rule) {
        if (rule == 1) {
            Node* a = cast<Node*>(self.vstack[self.vsp - 3 + 0].pval);
            Node* b = cast<Node*>(self.vstack[self.vsp - 3 + 2].pval);
            Node* RESULT = null;
            { RESULT = new Node(1, 0, a, b); }
            self.sp = self.sp - 3;
            self.vsp = self.vsp - 3;
            int top_state = self.sstack[self.sp - 1];
            int goto_state = self.goto_tbl[top_state * 32 + 4];
            self.sstack[self.sp] = goto_state;
            self.sp = self.sp + 1;
            SemVal rv;
            rv.kind = 3;
            rv.pval = cast<rawptr>(RESULT);
            self.vstack[self.vsp] = rv;
            self.vsp = self.vsp + 1;
        } else if (rule == 2) {
            Node* a = cast<Node*>(self.vstack[self.vsp - 3 + 0].pval);
            Node* b = cast<Node*>(self.vstack[self.vsp - 3 + 2].pval);
            Node* RESULT = null;
            { RESULT = new Node(2, 0, a, b); }
            self.sp = self.sp - 3;
            self.vsp = self.vsp - 3;
            int top_state = self.sstack[self.sp - 1];
            int goto_state = self.goto_tbl[top_state * 32 + 4];
            self.sstack[self.sp] = goto_state;
            self.sp = self.sp + 1;
            SemVal rv;
            rv.kind = 3;
            rv.pval = cast<rawptr>(RESULT);
            self.vstack[self.vsp] = rv;
            self.vsp = self.vsp + 1;
        } else if (rule == 3) {
            int n = self.vstack[self.vsp - 1 + 0].ival;
            Node* RESULT = null;
            { RESULT = new Node(0, n, null, null); }
            self.sp = self.sp - 1;
            self.vsp = self.vsp - 1;
            int top_state = self.sstack[self.sp - 1];
            int goto_state = self.goto_tbl[top_state * 32 + 4];
            self.sstack[self.sp] = goto_state;
            self.sp = self.sp + 1;
            SemVal rv;
            rv.kind = 3;
            rv.pval = cast<rawptr>(RESULT);
            self.vstack[self.vsp] = rv;
            self.vsp = self.vsp + 1;
        }
    }

    /* Empaquette une valeur de terminal (venant du lexer) en
       SemVal, selon le type declare de ce terminal. */
    SemVal pack_terminal(int term, int ival, str sval, rawptr pval) {
        SemVal sv;
        if (term == 0) { sv.kind = 0;
        } else if (term == 1) { sv.kind = 0;
        } else if (term == 2) { sv.kind = 1; sv.ival = ival;
        }
        return sv;
    }

    /* Parse une sequence de tokens deja lexee (tokens[i] = id de
       terminal, values[i] = SemVal associee -- utiliser
       pack_terminal() pour les construire). Retourne la SemVal
       finale (kind == -1 en cas d'erreur syntaxique). */
    SemVal parse(int* tokens, SemVal* values, int token_count) {
        self.sp = 1; self.sstack[0] = 0; self.vsp = 0;
        int ti = 0;
        SemVal result;
        result.kind = -1;
        bool done = false;
        while (!done) {
            int cur_state = self.sstack[self.sp - 1];
            int lookahead = tokens[ti];
            int act = self.action_tbl[cur_state * 32 + lookahead];
            if (act == 0) {
                done = true;
            } else if (act == -999999) {
                result = self.vstack[self.vsp - 1];
                done = true;
            } else if (act > 0) {
                self.sstack[self.sp] = act - 1;
                self.sp = self.sp + 1;
                self.vstack[self.vsp] = values[ti];
                self.vsp = self.vsp + 1;
                ti = ti + 1;
            } else {
                self.do_reduce(0 - act - 1);
            }
        }
        return result;
    }

    /* Integration AUTOMATIQUE avec un scanner genere par matlex :
       pilote sc.yylex() en direct (pas besoin de pre-tokeniser).
       Suppose l'interface standard matlex (Symbol{sym_type,
       line,column,ivalue,svalue}, methode yylex()). */
    SemVal parse_with_scanner(GenScanner* sc) {
        self.sp = 1; self.sstack[0] = 0; self.vsp = 0;
        Symbol cur_tok = sc.yylex();
        SemVal result;
        result.kind = -1;
        bool done = false;
        while (!done) {
            int cur_state = self.sstack[self.sp - 1];
            int lookahead = cur_tok.sym_type;
            if (lookahead == -1) { lookahead = 3; }
            int act = self.action_tbl[cur_state * 32 + lookahead];
            if (act == 0) {
                done = true;
            } else if (act == -999999) {
                result = self.vstack[self.vsp - 1];
                done = true;
            } else if (act > 0) {
                self.sstack[self.sp] = act - 1;
                self.sp = self.sp + 1;
                rawptr no_ptr = null;
                self.vstack[self.vsp] = self.pack_terminal(lookahead, cur_tok.ivalue, cur_tok.svalue, no_ptr);
                self.vsp = self.vsp + 1;
                cur_tok = sc.yylex();
            } else {
                self.do_reduce(0 - act - 1);
            }
        }
        return result;
    }
}


struct ValsHolderAst { SemVal[8] vals; }

int main() {
    GenParser p;
    p.init();

    int[8] toks;
    ValsHolderAst vh;
    str empty = "";
    rawptr np = null;

    toks[0] = sym.NUM;  vh.vals[0] = p.pack_terminal(sym.NUM, 2, empty, np);
    toks[1] = sym.PLUS; vh.vals[1] = p.pack_terminal(sym.PLUS, 0, empty, np);
    toks[2] = sym.NUM;  vh.vals[2] = p.pack_terminal(sym.NUM, 3, empty, np);
    toks[3] = sym.STAR; vh.vals[3] = p.pack_terminal(sym.STAR, 0, empty, np);
    toks[4] = sym.NUM;  vh.vals[4] = p.pack_terminal(sym.NUM, 4, empty, np);
    toks[5] = 3;         vh.vals[5] = p.pack_terminal(sym.NUM, 0, empty, np);

    SemVal result = p.parse(&toks, &vh.vals, 6);
    Node* root = cast<Node*>(result.pval);

    printf("arbre : ");
    p.print_node(root);
    printf("\n");
    printf("evaluation : %d (attendu 14, 2 + 3*4)\n", p.eval_node(root));

    return 0;
}
