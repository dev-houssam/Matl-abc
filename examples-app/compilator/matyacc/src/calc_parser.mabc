/* =====================================================
 * Parseur genere automatiquement par matyacc (round 3, .may)
 * NE PAS EDITER A LA MAIN -- regenerer depuis la spec .may
 * ===================================================== */

import <cstd>
import <cstring>

/* ---- constantes de token (%token), via #define ---- */
#define PLUS 0
#define MINUS 1
#define STAR 2
#define SLASH 3
#define LPAREN 4
#define RPAREN 5
#define NUM 6
struct GenParser {
    int[512] action_tbl;
    int[512] goto_tbl;
    int[128] sstack;
    int sp;
    int[128] vstack;
    int vsp;

    void init() {
        int i = 0;
        while (i < 512) { self.action_tbl[i] = 0; self.goto_tbl[i] = -1; i = i + 1; }
        self.action_tbl[4] = 2;
        self.action_tbl[6] = 3;
        self.goto_tbl[8] = 3;
        self.goto_tbl[9] = 4;
        self.goto_tbl[10] = 5;
        self.action_tbl[36] = 2;
        self.action_tbl[38] = 3;
        self.goto_tbl[40] = 6;
        self.goto_tbl[41] = 4;
        self.goto_tbl[42] = 5;
        self.action_tbl[64] = -9;
        self.action_tbl[65] = -9;
        self.action_tbl[66] = -9;
        self.action_tbl[67] = -9;
        self.action_tbl[69] = -9;
        self.action_tbl[71] = -9;
        self.action_tbl[96] = 8;
        self.action_tbl[97] = 9;
        self.action_tbl[103] = -999999;
        self.action_tbl[128] = -4;
        self.action_tbl[129] = -4;
        self.action_tbl[130] = 10;
        self.action_tbl[131] = 11;
        self.action_tbl[133] = -4;
        self.action_tbl[135] = -4;
        self.action_tbl[160] = -7;
        self.action_tbl[161] = -7;
        self.action_tbl[162] = -7;
        self.action_tbl[163] = -7;
        self.action_tbl[165] = -7;
        self.action_tbl[167] = -7;
        self.action_tbl[192] = 8;
        self.action_tbl[193] = 9;
        self.action_tbl[197] = 12;
        self.action_tbl[228] = 2;
        self.action_tbl[230] = 3;
        self.goto_tbl[233] = 12;
        self.goto_tbl[234] = 5;
        self.action_tbl[260] = 2;
        self.action_tbl[262] = 3;
        self.goto_tbl[265] = 13;
        self.goto_tbl[266] = 5;
        self.action_tbl[292] = 2;
        self.action_tbl[294] = 3;
        self.goto_tbl[298] = 14;
        self.action_tbl[324] = 2;
        self.action_tbl[326] = 3;
        self.goto_tbl[330] = 15;
        self.action_tbl[352] = -8;
        self.action_tbl[353] = -8;
        self.action_tbl[354] = -8;
        self.action_tbl[355] = -8;
        self.action_tbl[357] = -8;
        self.action_tbl[359] = -8;
        self.action_tbl[384] = -2;
        self.action_tbl[385] = -2;
        self.action_tbl[386] = 10;
        self.action_tbl[387] = 11;
        self.action_tbl[389] = -2;
        self.action_tbl[391] = -2;
        self.action_tbl[416] = -3;
        self.action_tbl[417] = -3;
        self.action_tbl[418] = 10;
        self.action_tbl[419] = 11;
        self.action_tbl[421] = -3;
        self.action_tbl[423] = -3;
        self.action_tbl[448] = -5;
        self.action_tbl[449] = -5;
        self.action_tbl[450] = -5;
        self.action_tbl[451] = -5;
        self.action_tbl[453] = -5;
        self.action_tbl[455] = -5;
        self.action_tbl[480] = -6;
        self.action_tbl[481] = -6;
        self.action_tbl[482] = -6;
        self.action_tbl[483] = -6;
        self.action_tbl[485] = -6;
        self.action_tbl[487] = -6;
    }

    /* Parse une sequence de tokens deja lexee (tokens[i] = id
       de token, values[i] = valeur semantique entiere associee).
       Retourne la valeur $$ finale, ou -2147483648 en cas
       d'erreur syntaxique. */
    int parse(int* tokens, int* values, int token_count) {
        self.sp = 1; self.sstack[0] = 0;
        self.vsp = 0;
        int ti = 0;
        int result = -2147483648;
        int done = 0;
        while (done == 0) {
            int cur_state = self.sstack[self.sp - 1];
            int lookahead = tokens[ti];
            int act = self.action_tbl[cur_state * 32 + lookahead];
            if (act == 0) {
                done = 1;
            } else if (act == -999999) {
                result = self.vstack[self.vsp - 1];
                done = 1;
            } else if (act > 0) {
                self.sstack[self.sp] = act - 1;
                self.sp = self.sp + 1;
                self.vstack[self.vsp] = values[ti];
                self.vsp = self.vsp + 1;
                ti = ti + 1;
            } else {
                int rule = 0 - act - 1;
                if (rule == 1) {
                    int dollar_1 = self.vstack[self.vsp - 3 + 0];
                    int dollar_2 = self.vstack[self.vsp - 3 + 1];
                    int dollar_3 = self.vstack[self.vsp - 3 + 2];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1 + dollar_3; }
                    self.sp = self.sp - 3;
                    self.vsp = self.vsp - 3;
                    int lhs_sym = 8;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 2) {
                    int dollar_1 = self.vstack[self.vsp - 3 + 0];
                    int dollar_2 = self.vstack[self.vsp - 3 + 1];
                    int dollar_3 = self.vstack[self.vsp - 3 + 2];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1 - dollar_3; }
                    self.sp = self.sp - 3;
                    self.vsp = self.vsp - 3;
                    int lhs_sym = 8;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 3) {
                    int dollar_1 = self.vstack[self.vsp - 1 + 0];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1; }
                    self.sp = self.sp - 1;
                    self.vsp = self.vsp - 1;
                    int lhs_sym = 8;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 4) {
                    int dollar_1 = self.vstack[self.vsp - 3 + 0];
                    int dollar_2 = self.vstack[self.vsp - 3 + 1];
                    int dollar_3 = self.vstack[self.vsp - 3 + 2];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1 * dollar_3; }
                    self.sp = self.sp - 3;
                    self.vsp = self.vsp - 3;
                    int lhs_sym = 9;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 5) {
                    int dollar_1 = self.vstack[self.vsp - 3 + 0];
                    int dollar_2 = self.vstack[self.vsp - 3 + 1];
                    int dollar_3 = self.vstack[self.vsp - 3 + 2];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1 / dollar_3; }
                    self.sp = self.sp - 3;
                    self.vsp = self.vsp - 3;
                    int lhs_sym = 9;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 6) {
                    int dollar_1 = self.vstack[self.vsp - 1 + 0];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1; }
                    self.sp = self.sp - 1;
                    self.vsp = self.vsp - 1;
                    int lhs_sym = 9;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 7) {
                    int dollar_1 = self.vstack[self.vsp - 3 + 0];
                    int dollar_2 = self.vstack[self.vsp - 3 + 1];
                    int dollar_3 = self.vstack[self.vsp - 3 + 2];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_2; }
                    self.sp = self.sp - 3;
                    self.vsp = self.vsp - 3;
                    int lhs_sym = 10;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 8) {
                    int dollar_1 = self.vstack[self.vsp - 1 + 0];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1; }
                    self.sp = self.sp - 1;
                    self.vsp = self.vsp - 1;
                    int lhs_sym = 10;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                }
            }
        }
        return result;
    }
}

/* ---- code utilisateur final (apres le 2e %%), typiquement main() ---- */


int main() {
    GenParser p;
    p.init();

    /* "( 3 + 4 ) * 2 - 5 / 5"  =  ((3+4)*2) - (5/5)  =  14 - 1  =  13 */
    int[16] toks;
    int[16] vals;
    int n = 0;

    toks[n] = LPAREN; vals[n] = 0; n = n + 1;
    toks[n] = NUM;    vals[n] = 3; n = n + 1;
    toks[n] = PLUS;   vals[n] = 0; n = n + 1;
    toks[n] = NUM;    vals[n] = 4; n = n + 1;
    toks[n] = RPAREN; vals[n] = 0; n = n + 1;
    toks[n] = STAR;   vals[n] = 0; n = n + 1;
    toks[n] = NUM;    vals[n] = 2; n = n + 1;
    toks[n] = MINUS;  vals[n] = 0; n = n + 1;
    toks[n] = NUM;    vals[n] = 5; n = n + 1;
    toks[n] = SLASH;  vals[n] = 0; n = n + 1;
    toks[n] = NUM;    vals[n] = 5; n = n + 1;
    toks[n] = 7;      vals[n] = 0; n = n + 1;   /* '$' = id 7 (apres les 7 tokens declares) */

    int result = p.parse(&toks, &vals, n);
    printf("( 3 + 4 ) * 2 - 5 / 5 = %d (attendu 13)\n", result);

    /* verification supplementaire : priorite sans parentheses */
    int[16] toks2;
    int[16] vals2;
    int m = 0;
    toks2[m] = NUM;   vals2[m] = 2; m = m + 1;
    toks2[m] = PLUS;  vals2[m] = 0; m = m + 1;
    toks2[m] = NUM;   vals2[m] = 3; m = m + 1;
    toks2[m] = STAR;  vals2[m] = 0; m = m + 1;
    toks2[m] = NUM;   vals2[m] = 4; m = m + 1;
    toks2[m] = 7;     vals2[m] = 0; m = m + 1;

    p.init();
    int result2 = p.parse(&toks2, &vals2, m);
    printf("2 + 3 * 4 = %d (attendu 14)\n", result2);

    return 0;
}

