/* =====================================================
 * Parseur genere automatiquement par matyacc (round 4, .may)
 * Style JCUP -- NE PAS EDITER A LA MAIN
 * ===================================================== */

import <cstd>
import <cstring>

/* ---- constantes de token (terminal), via #define ---- */
#define NUM 0
/* SemVal : valeur semantique 'personnalisable' -- int, str,
   ou pointeur generique (struct/tableau/pile/arbre/...). */
/* stub minimal, uniquement pour satisfaire le typeur */
struct Symbol {
    int sym_type;
    int line;
    int column;
    int ivalue;
    str svalue;
}
struct GenScanner {
    int dummy;
    Symbol yylex() {
        Symbol s;
        s.sym_type = -1;
        return s;
    }
}

struct SemVal {
    int  kind;
    int  ival;
    str  sval;
    rawptr pval;
}

struct GenParser {
    int[96] action_tbl;
    int[96] goto_tbl;
    int[128] sstack;
    int sp;
    SemVal[128] vstack;
    int vsp;

    void init() {
        int i = 0;
        while (i < 96) { self.action_tbl[i] = 0; self.goto_tbl[i] = -1; i = i + 1; }
        self.action_tbl[0] = -2;
        self.action_tbl[1] = -2;
        self.goto_tbl[2] = 1;
        self.action_tbl[32] = 3;
        self.action_tbl[33] = -999999;
        self.action_tbl[64] = -3;
        self.action_tbl[65] = -3;
    }

    /* Dispatch de reduction commun (appele par parse() et
       parse_with_scanner()) : execute l'action de la regle,
       depile, calcule le GOTO, empile le resultat. */
    void do_reduce(int rule) {
        if (rule == 1) {
            int RESULT = 0;
            { RESULT = 0; }
            self.sp = self.sp - 0;
            self.vsp = self.vsp - 0;
            int top_state = self.sstack[self.sp - 1];
            int goto_state = self.goto_tbl[top_state * 32 + 2];
            self.sstack[self.sp] = goto_state;
            self.sp = self.sp + 1;
            SemVal rv;
            rv.kind = 0;
            rv.ival = RESULT;
            self.vstack[self.vsp] = rv;
            self.vsp = self.vsp + 1;
        } else if (rule == 2) {
            int a = self.vstack[self.vsp - 2 + 0].ival;
            int n = self.vstack[self.vsp - 2 + 1].ival;
            int RESULT = 0;
            { RESULT = a + n; }
            self.sp = self.sp - 2;
            self.vsp = self.vsp - 2;
            int top_state = self.sstack[self.sp - 1];
            int goto_state = self.goto_tbl[top_state * 32 + 2];
            self.sstack[self.sp] = goto_state;
            self.sp = self.sp + 1;
            SemVal rv;
            rv.kind = 0;
            rv.ival = RESULT;
            self.vstack[self.vsp] = rv;
            self.vsp = self.vsp + 1;
        }
    }

    /* Empaquette une valeur de terminal (venant du lexer) en
       SemVal, selon le type declare de ce terminal. */
    SemVal pack_terminal(int term, int ival, str sval, rawptr pval) {
        SemVal sv;
        if (term == 0) { sv.kind = 0; sv.ival = ival;
        }
        return sv;
    }

    /* Parse une sequence de tokens deja lexee (tokens[i] = id de
       terminal, values[i] = SemVal associee -- utiliser
       pack_terminal() pour les construire). Retourne la SemVal
       finale (kind == -1 en cas d'erreur syntaxique). */
    SemVal parse(int* tokens, SemVal* values, int token_count) {
        self.sp = 1; self.sstack[0] = 0; self.vsp = 0;
        int ti = 0;
        SemVal result;
        result.kind = -1;
        int done = 0;
        while (done == 0) {
            int cur_state = self.sstack[self.sp - 1];
            int lookahead = tokens[ti];
            int act = self.action_tbl[cur_state * 32 + lookahead];
            if (act == 0) {
                done = 1;
            } else if (act == -999999) {
                result = self.vstack[self.vsp - 1];
                done = 1;
            } else if (act > 0) {
                self.sstack[self.sp] = act - 1;
                self.sp = self.sp + 1;
                self.vstack[self.vsp] = values[ti];
                self.vsp = self.vsp + 1;
                ti = ti + 1;
            } else {
                self.do_reduce(0 - act - 1);
            }
        }
        return result;
    }

    /* Integration AUTOMATIQUE avec un scanner genere par matlex :
       pilote sc.yylex() en direct (pas besoin de pre-tokeniser).
       Suppose l'interface standard matlex (Symbol{sym_type,
       line,column,ivalue,svalue}, methode yylex()). */
    SemVal parse_with_scanner(GenScanner* sc) {
        self.sp = 1; self.sstack[0] = 0; self.vsp = 0;
        Symbol cur_tok = sc.yylex();
        SemVal result;
        result.kind = -1;
        int done = 0;
        while (done == 0) {
            int cur_state = self.sstack[self.sp - 1];
            int lookahead = cur_tok.sym_type;
            if (lookahead == -1) { lookahead = 1; }
            int act = self.action_tbl[cur_state * 32 + lookahead];
            if (act == 0) {
                done = 1;
            } else if (act == -999999) {
                result = self.vstack[self.vsp - 1];
                done = 1;
            } else if (act > 0) {
                self.sstack[self.sp] = act - 1;
                self.sp = self.sp + 1;
                rawptr no_ptr = null;
                self.vstack[self.vsp] = self.pack_terminal(lookahead, cur_tok.ivalue, cur_tok.svalue, no_ptr);
                self.vsp = self.vsp + 1;
                cur_tok = sc.yylex();
            } else {
                self.do_reduce(0 - act - 1);
            }
        }
        return result;
    }
}


struct ValsHolder4 { SemVal[8] vals; }

int main() {
    GenParser p;
    p.init();

    /* "NUM NUM NUM $" -- 5 7 2, attendu somme = 14 */
    int[8] toks;
    ValsHolder4 vh;
    str empty = "";
    rawptr np = null;

    toks[0] = NUM; vh.vals[0] = p.pack_terminal(NUM, 5, empty, np);
    toks[1] = NUM; vh.vals[1] = p.pack_terminal(NUM, 7, empty, np);
    toks[2] = NUM; vh.vals[2] = p.pack_terminal(NUM, 2, empty, np);
    toks[3] = 1;   vh.vals[3] = p.pack_terminal(NUM, 0, empty, np);  /* '$' = id 1 */

    SemVal result = p.parse(&toks, &vh.vals, 4);
    printf("somme de [5, 7, 2] via liste epsilon = %d (attendu 14)\n", result.ival);

    /* liste vide : juste '$' */
    p.init();
    int[8] toks2;
    ValsHolder4 vh2;
    toks2[0] = 1; vh2.vals[0] = p.pack_terminal(NUM, 0, empty, np);
    SemVal result2 = p.parse(&toks2, &vh2.vals, 1);
    printf("liste vide (epsilon pur) = %d (attendu 0)\n", result2.ival);

    return 0;
}
