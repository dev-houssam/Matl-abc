/* =====================================================
 * Parseur genere automatiquement par matyacc (round 3, .may)
 * NE PAS EDITER A LA MAIN -- regenerer depuis la spec .may
 * ===================================================== */

import <cstd>
import <cstring>

/* ---- constantes de token (%token), via #define ---- */
#define PLUS 0
#define STAR 1
#define NUM 2
struct GenParser {
    int[288] action_tbl;
    int[288] goto_tbl;
    int[128] sstack;
    int sp;
    int[128] vstack;
    int vsp;

    void init() {
        int i = 0;
        while (i < 288) { self.action_tbl[i] = 0; self.goto_tbl[i] = -1; i = i + 1; }
        self.action_tbl[2] = 2;
        self.goto_tbl[4] = 2;
        self.goto_tbl[5] = 3;
        self.goto_tbl[6] = 4;
        self.action_tbl[32] = -6;
        self.action_tbl[33] = -6;
        self.action_tbl[35] = -6;
        self.action_tbl[64] = 6;
        self.action_tbl[67] = -999999;
        self.action_tbl[96] = -3;
        self.action_tbl[97] = 7;
        self.action_tbl[99] = -3;
        self.action_tbl[128] = -5;
        self.action_tbl[129] = -5;
        self.action_tbl[131] = -5;
        self.action_tbl[162] = 2;
        self.goto_tbl[165] = 7;
        self.goto_tbl[166] = 4;
        self.action_tbl[194] = 2;
        self.goto_tbl[198] = 8;
        self.action_tbl[224] = -2;
        self.action_tbl[225] = 7;
        self.action_tbl[227] = -2;
        self.action_tbl[256] = -4;
        self.action_tbl[257] = -4;
        self.action_tbl[259] = -4;
    }

    /* Parse une sequence de tokens deja lexee (tokens[i] = id
       de token, values[i] = valeur semantique entiere associee).
       Retourne la valeur $$ finale, ou -2147483648 en cas
       d'erreur syntaxique. */
    int parse(int* tokens, int* values, int token_count) {
        self.sp = 1; self.sstack[0] = 0;
        self.vsp = 0;
        int ti = 0;
        int result = -2147483648;
        int done = 0;
        while (done == 0) {
            int cur_state = self.sstack[self.sp - 1];
            int lookahead = tokens[ti];
            int act = self.action_tbl[cur_state * 32 + lookahead];
            if (act == 0) {
                done = 1;
            } else if (act == -999999) {
                result = self.vstack[self.vsp - 1];
                done = 1;
            } else if (act > 0) {
                self.sstack[self.sp] = act - 1;
                self.sp = self.sp + 1;
                self.vstack[self.vsp] = values[ti];
                self.vsp = self.vsp + 1;
                ti = ti + 1;
            } else {
                int rule = 0 - act - 1;
                if (rule == 1) {
                    int dollar_1 = self.vstack[self.vsp - 3 + 0];
                    int dollar_2 = self.vstack[self.vsp - 3 + 1];
                    int dollar_3 = self.vstack[self.vsp - 3 + 2];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1 + dollar_3; }
                    self.sp = self.sp - 3;
                    self.vsp = self.vsp - 3;
                    int lhs_sym = 4;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 2) {
                    int dollar_1 = self.vstack[self.vsp - 1 + 0];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1; }
                    self.sp = self.sp - 1;
                    self.vsp = self.vsp - 1;
                    int lhs_sym = 4;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 3) {
                    int dollar_1 = self.vstack[self.vsp - 3 + 0];
                    int dollar_2 = self.vstack[self.vsp - 3 + 1];
                    int dollar_3 = self.vstack[self.vsp - 3 + 2];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1 * dollar_3; }
                    self.sp = self.sp - 3;
                    self.vsp = self.vsp - 3;
                    int lhs_sym = 5;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 4) {
                    int dollar_1 = self.vstack[self.vsp - 1 + 0];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1; }
                    self.sp = self.sp - 1;
                    self.vsp = self.vsp - 1;
                    int lhs_sym = 5;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                } else if (rule == 5) {
                    int dollar_1 = self.vstack[self.vsp - 1 + 0];
                    int dollar_dollar = 0;
                    { dollar_dollar = dollar_1; }
                    self.sp = self.sp - 1;
                    self.vsp = self.vsp - 1;
                    int lhs_sym = 6;
                    int top_state = self.sstack[self.sp - 1];
                    int goto_state = self.goto_tbl[top_state * 32 + lhs_sym];
                    self.sstack[self.sp] = goto_state;
                    self.sp = self.sp + 1;
                    self.vstack[self.vsp] = dollar_dollar;
                    self.vsp = self.vsp + 1;
                }
            }
        }
        return result;
    }
}


int main() {
    GenParser p;
    p.init();

    /* "3 + 4 * 2" -> tokens NUM(3) PLUS NUM(4) STAR NUM(2) $ */
    int[8] toks;
    int[8] vals;
    toks[0] = NUM; vals[0] = 3;
    toks[1] = PLUS; vals[1] = 0;
    toks[2] = NUM; vals[2] = 4;
    toks[3] = STAR; vals[3] = 0;
    toks[4] = NUM; vals[4] = 2;
    toks[5] = 3; vals[5] = 0;   /* symbole '$' = id 3 (apres PLUS=0,STAR=1,NUM=2) */

    int result = p.parse(&toks, &vals, 6);
    printf("3 + 4 * 2 = %d (attendu 11, priorite * > + respectee)\n", result);
    return 0;
}
