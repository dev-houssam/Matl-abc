/* =====================================================
 * Scanner genere automatiquement par matlex (round 7, .max)
 * NE PAS EDITER A LA MAIN -- regenerer depuis la spec .max
 * ===================================================== */

import <cstd>
import <cstring>

/* Symbol : transporte un token vers un futur parser matyacc
   (type + position + valeur semantique optionnelle), a la
   maniere du Symbol de CUP consomme par un lexer JFlex. Le
   TYPE reste un simple entier : matlex ne connait pas les
   noms symboliques des tokens, c'est le role de matyacc. */
struct Symbol {
    int sym_type;
    int line;
    int column;
    int ivalue;
    str svalue;
}

struct GenScanner {
    char* src;
    int pos;
    int len;
    int[1536] trans;
    int[6] is_final;
    char[256] yytext_buf;
    int yyleng_val;
    int yychar_val;
    int yyline;
    int yycolumn;
    int lex_state;

    void init(char* source) {
        self.src = source;
        self.pos = 0;
        self.len = cast<int>(strlen(source));
        self.yychar_val = 0;
        self.yyline = 0;
        self.yycolumn = 0;
        self.lex_state = 0;
        int i = 0;
        while (i < 1536) { self.trans[i] = -1; i = i + 1; }
        self.trans[9] = 1;
        self.trans[10] = 1;
        self.trans[13] = 1;
        self.trans[32] = 1;
        self.trans[48] = 2;
        self.trans[49] = 2;
        self.trans[50] = 2;
        self.trans[51] = 2;
        self.trans[52] = 2;
        self.trans[53] = 2;
        self.trans[54] = 2;
        self.trans[55] = 2;
        self.trans[56] = 2;
        self.trans[57] = 2;
        self.trans[65] = 3;
        self.trans[265] = 1;
        self.trans[266] = 1;
        self.trans[269] = 1;
        self.trans[288] = 1;
        self.trans[560] = 2;
        self.trans[561] = 2;
        self.trans[562] = 2;
        self.trans[563] = 2;
        self.trans[564] = 2;
        self.trans[565] = 2;
        self.trans[566] = 2;
        self.trans[567] = 2;
        self.trans[568] = 2;
        self.trans[569] = 2;
        self.trans[836] = 4;
        self.trans[1092] = 5;
        self.is_final[0] = -1;
        self.is_final[1] = 0;
        self.is_final[2] = 2;
        self.is_final[3] = -1;
        self.is_final[4] = -1;
        self.is_final[5] = 1;
    }

    int at_end() { return self.pos >= self.len; }

    int step(int state, char c) {
        int b = cast<int>(c);
        if (b < 0) { return -1; }
        return self.trans[state * 256 + b];
    }

    /* API JFlex -- champs/methodes exposes a l'utilisateur */
    str yytext() { return &self.yytext_buf; }
    int yylength() { return self.yyleng_val; }
    int yychar() { return self.yychar_val; }
    int yystate() { return self.lex_state; }
    void yybegin(int s) { self.lex_state = s; }
    void yypushback(int n) {
        self.pos = self.pos - n;
        if (self.pos < 0) { self.pos = 0; }
    }
    void yyreset(char* new_source) {
        self.init(new_source);
    }

    /* Avance yyline/yycolumn de n caracteres a partir de self.pos. */
    void advance_line_col(int n) {
        int i = 0;
        while (i < n) {
            char c = self.src[self.pos + i];
            if (c == cast<char>(10)) { self.yyline = self.yyline + 1; self.yycolumn = 0; }
            else { self.yycolumn = self.yycolumn + 1; }
            i = i + 1;
        }
    }

    /* Une passe de maximal munch ; remplit yytext_buf/yyleng_val.
       Retourne l'id de regle gagnante, ou -1 si aucune regle
       n'accepte (erreur lexicale -- 1 caractere consomme). */
    int scan_one() {
        self.yychar_val = self.pos;
        int state = 0;
        int best_rule = -1;
        int best_i = 0;
        int i = 0;
        while (self.pos + i < self.len) {
            char c = self.src[self.pos + i];
            int nstate = self.step(state, c);
            if (nstate == -1) { break; }
            state = nstate;
            i = i + 1;
            if (self.is_final[state] != -1) { best_rule = self.is_final[state]; best_i = i; }
        }
        if (best_rule == -1) {
            self.yyleng_val = 1;
            self.yytext_buf[0] = self.src[self.pos];
            self.yytext_buf[1] = cast<char>(0);
            self.advance_line_col(1);
            self.pos = self.pos + 1;
            return -1;
        }
        self.yyleng_val = best_i;
        int k = 0;
        while (k < best_i && k < 255) { self.yytext_buf[k] = self.src[self.pos + k]; k = k + 1; }
        self.yytext_buf[k] = cast<char>(0);
        self.advance_line_col(best_i);
        self.pos = self.pos + best_i;
        return best_rule;
    }

    /* ---- prologue utilisateur (%{ ... %}), methodes ---- */
/* Scanner pour le test d'integration matlex <-> matyacc.
   IMPORTANT : les id de token (symbol(0), symbol(1)) doivent
   correspondre EXACTEMENT a l'ordre de declaration des "terminal"
   dans la spec .may de matyacc (ADD=0, NUMBER=1) -- synchronisation
   MANUELLE entre les deux specs pour l'instant (voir doc : "reste a
   faire" sur l'integration complete au niveau des noms de token). */
Symbol symbol(int t) {
    Symbol s;
    s.sym_type = t;
    s.line = self.yyline;
    s.column = self.yycolumn;
    s.ivalue = 0;
    return s;
}

Symbol symbolInt(int t, int v) {
    Symbol s;
    s.sym_type = t;
    s.line = self.yyline;
    s.column = self.yycolumn;
    s.ivalue = v;
    return s;
}

    /* yylex() : boucle de scan style flex/JFlex.
       Symbol.sym_type == -1 signale la fin d'entree. */
    Symbol yylex() {
        int cont = 1;
        Symbol result;
        result.sym_type = -1;
        result.line = self.yyline;
        result.column = self.yycolumn;
        result.ivalue = 0;
        while (cont == 1) {
            if (self.at_end()) {
                cont = 0;
            } else {
                int rid = self.scan_one();
                if (rid == -1) {
                    int lex_err = 1;
                } else if (rid == 0) { int skip = 0; }
                else if (rid == 1) { return self.symbol(0); }
                else if (rid == 2) { return self.symbolInt(1, atoi(self.yytext().data())); }
            }
        }
        return result;
    }
}
/* =====================================================
 * Parseur genere automatiquement par matyacc (round 4, .may)
 * Style JCUP -- NE PAS EDITER A LA MAIN
 * ===================================================== */


/* ---- constantes de token (terminal), via #define ---- */
#define ADD 0
#define NUMBER 1
/* SemVal : valeur semantique 'personnalisable' -- int, str,
   ou pointeur generique (struct/tableau/pile/arbre/...). */
struct SemVal {
    int  kind;
    int  ival;
    str  sval;
    rawptr pval;
}

struct GenParser {
    int[160] action_tbl;
    int[160] goto_tbl;
    int[128] sstack;
    int sp;
    SemVal[128] vstack;
    int vsp;

    void init() {
        int i = 0;
        while (i < 160) { self.action_tbl[i] = 0; self.goto_tbl[i] = -1; i = i + 1; }
        self.action_tbl[0] = 2;
        self.goto_tbl[3] = 2;
        self.action_tbl[33] = 4;
        self.action_tbl[66] = -999999;
        self.action_tbl[97] = 5;
        self.action_tbl[130] = -2;
    }

    /* Dispatch de reduction commun (appele par parse() et
       parse_with_scanner()) : execute l'action de la regle,
       depile, calcule le GOTO, empile le resultat. */
    void do_reduce(int rule) {
        if (rule == 1) {
            int a = self.vstack[self.vsp - 3 + 1].ival;
            int b = self.vstack[self.vsp - 3 + 2].ival;
            int RESULT = 0;
            {
          RESULT = a + b;
      }
            self.sp = self.sp - 3;
            self.vsp = self.vsp - 3;
            int top_state = self.sstack[self.sp - 1];
            int goto_state = self.goto_tbl[top_state * 32 + 3];
            self.sstack[self.sp] = goto_state;
            self.sp = self.sp + 1;
            SemVal rv;
            rv.kind = 0;
            rv.ival = RESULT;
            self.vstack[self.vsp] = rv;
            self.vsp = self.vsp + 1;
        }
    }

    /* Empaquette une valeur de terminal (venant du lexer) en
       SemVal, selon le type declare de ce terminal. */
    SemVal pack_terminal(int term, int ival, str sval, rawptr pval) {
        SemVal sv;
        if (term == 0) { sv.kind = -1;
        } else if (term == 1) { sv.kind = 0; sv.ival = ival;
        }
        return sv;
    }

    /* Parse une sequence de tokens deja lexee (tokens[i] = id de
       terminal, values[i] = SemVal associee -- utiliser
       pack_terminal() pour les construire). Retourne la SemVal
       finale (kind == -1 en cas d'erreur syntaxique). */
    SemVal parse(int* tokens, SemVal* values, int token_count) {
        self.sp = 1; self.sstack[0] = 0; self.vsp = 0;
        int ti = 0;
        SemVal result;
        result.kind = -1;
        int done = 0;
        while (done == 0) {
            int cur_state = self.sstack[self.sp - 1];
            int lookahead = tokens[ti];
            int act = self.action_tbl[cur_state * 32 + lookahead];
            if (act == 0) {
                done = 1;
            } else if (act == -999999) {
                result = self.vstack[self.vsp - 1];
                done = 1;
            } else if (act > 0) {
                self.sstack[self.sp] = act - 1;
                self.sp = self.sp + 1;
                self.vstack[self.vsp] = values[ti];
                self.vsp = self.vsp + 1;
                ti = ti + 1;
            } else {
                self.do_reduce(0 - act - 1);
            }
        }
        return result;
    }

    /* Integration AUTOMATIQUE avec un scanner genere par matlex :
       pilote sc.yylex() en direct (pas besoin de pre-tokeniser).
       Suppose l'interface standard matlex (Symbol{sym_type,
       line,column,ivalue,svalue}, methode yylex()). */
    SemVal parse_with_scanner(GenScanner* sc) {
        self.sp = 1; self.sstack[0] = 0; self.vsp = 0;
        Symbol cur_tok = sc.yylex();
        SemVal result;
        result.kind = -1;
        int done = 0;
        while (done == 0) {
            int cur_state = self.sstack[self.sp - 1];
            int lookahead = cur_tok.sym_type;
            if (lookahead == -1) { lookahead = 2; }
            int act = self.action_tbl[cur_state * 32 + lookahead];
            if (act == 0) {
                done = 1;
            } else if (act == -999999) {
                result = self.vstack[self.vsp - 1];
                done = 1;
            } else if (act > 0) {
                self.sstack[self.sp] = act - 1;
                self.sp = self.sp + 1;
                rawptr no_ptr = null;
                self.vstack[self.vsp] = self.pack_terminal(lookahead, cur_tok.ivalue, cur_tok.svalue, no_ptr);
                self.vsp = self.vsp + 1;
                cur_tok = sc.yylex();
            } else {
                self.do_reduce(0 - act - 1);
            }
        }
        return result;
    }
}


int main() {
    GenScanner sc;
    sc.init("ADD 3 4");

    GenParser p;
    p.init();

    SemVal result = p.parse_with_scanner(&sc);
    printf("=== integration automatique matlex <-> matyacc ===\n");
    printf("ADD 3 4  =>  RESULT = %d (attendu 7)\n", result.ival);

    return 0;
}
