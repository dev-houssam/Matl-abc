/* posixshim.mabh — interface pour posix_shim.c (contournement du bug
 * de resolution de open/lseek/dup/dup2/ftruncate/lockf, voir
 * extra_file.mabh et matlabc_doc/34_file_wrapper.md).
 */
int  matlabc_open2(char* path, int flags);
int  matlabc_open3(char* path, int flags, int mode);
long matlabc_lseek(int fd, long offset, int whence);
int  matlabc_dup(int fd);
int  matlabc_dup2(int oldfd, int newfd);
int  matlabc_ftruncate(int fd, long length);
int  matlabc_lockf(int fd, int cmd, long len);
