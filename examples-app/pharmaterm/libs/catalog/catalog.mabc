/* ================================================================
 * catalog.mabc — Modele metier : medicaments et pharmacie
 * ================================================================
 * Sous-projet dependant de `search` : la Pharmacy maintient un
 * SearchIndex sur les noms, molecules et symptomes de son catalogue.
 * C'est ce couplage qui justifie le [project] depends = ["search"] :
 * catalog ne compile pas sans les types de search.
 *
 * Convention : identifiants en ANGLAIS, commentaires en FRANCAIS.
 * ================================================================ */

import <std>

/* catalog utilise SearchIndex : la dependance est visible ici, pas
   seulement dans conf.toml */
import <search>

/* ---- Categorie therapeutique ---- */
enum Category {
    ANALGESIC     = 0,   /* antidouleur */
    ANTIBIOTIC    = 1,
    ANTIHISTAMINE = 2,   /* antiallergique */
    ANTISEPTIC    = 3,
    DIGESTIVE     = 4,
    RESPIRATORY   = 5,
    VITAMIN       = 6,
    DERMATOLOGY   = 7
}

/* ---- Statut de delivrance ---- */
enum DeliveryStatus {
    OVER_THE_COUNTER = 0,   /* libre acces */
    PRESCRIPTION     = 1,   /* ordonnance obligatoire */
    RESTRICTED       = 2    /* ordonnance securisee */
}

/* ---- Resultat d'une operation sur le catalogue ---- */
enum CatalogResult {
    SUCCESS        = 0,
    OUT_OF_STOCK   = -1,
    NOT_FOUND      = -2,
    NEEDS_RX       = -3,   /* ordonnance requise */
    INVALID_AMOUNT = -4
}

/* ================================================================
 * Medicine — un medicament du catalogue
 * ================================================================ */
struct Medicine {
    int id;
    str name;              /* nom commercial : "Doliprane" */
    str molecule;          /* DCI : "paracetamol" */
    str symptoms;          /* mots-cles : "douleur fievre maux de tete" */
    str advice;            /* conseil du pharmacien */
    Category category;
    DeliveryStatus status;
    int price_cents;       /* en centimes : evite tout flottant en caisse */
    int stock;
    int max_daily_doses;   /* posologie maximale par 24h */

    void init(int id, str name, str molecule, Category category,
              DeliveryStatus status, int price_cents, int stock) {
        self.id = id;
        self.name = name;
        self.molecule = molecule;
        self.category = category;
        self.status = status;
        self.price_cents = price_cents;
        self.stock = stock;
        self.symptoms = "";
        self.advice = "";
        self.max_daily_doses = 0;
    }

    /* enrichit la fiche : symptomes traites et conseil associe */
    void describe(str symptoms, str advice, int max_daily_doses) {
        self.symptoms = symptoms;
        self.advice = advice;
        self.max_daily_doses = max_daily_doses;
    }

    bool is_available() { return self.stock > 0; }
    bool needs_prescription() { return self.status != DeliveryStatus.OVER_THE_COUNTER; }

    /* prix formate pour l'affichage : 495 -> "4.95" */
    str price_text() {
        int euros = self.price_cents / 100;
        int cents = self.price_cents % 100;
        if (cents < 10) { return f"{euros}.0{cents}"; }
        return f"{euros}.{cents}";
    }

    str category_text() {
        match (self.category) {
            Category.ANALGESIC     => { return "Antidouleur"; }
            Category.ANTIBIOTIC    => { return "Antibiotique"; }
            Category.ANTIHISTAMINE => { return "Antiallergique"; }
            Category.ANTISEPTIC    => { return "Antiseptique"; }
            Category.DIGESTIVE     => { return "Digestif"; }
            Category.RESPIRATORY   => { return "Respiratoire"; }
            Category.VITAMIN       => { return "Vitamine"; }
            Category.DERMATOLOGY   => { return "Dermatologie"; }
        }
        return "Autre";
    }

    str status_text() {
        match (self.status) {
            DeliveryStatus.OVER_THE_COUNTER => { return "Libre acces"; }
            DeliveryStatus.PRESCRIPTION     => { return "Ordonnance"; }
            DeliveryStatus.RESTRICTED       => { return "Ordonnance securisee"; }
        }
        return "?";
    }
}

/* ================================================================
 * CartLine — une ligne du panier
 * ================================================================ */
struct CartLine {
    int medicine_id;
    int quantity;
    int unit_price_cents;   /* fige le prix au moment de l'ajout */

    void init(int medicine_id, int quantity, int unit_price_cents) {
        self.medicine_id = medicine_id;
        self.quantity = quantity;
        self.unit_price_cents = unit_price_cents;
    }

    int total_cents() { return self.quantity * self.unit_price_cents; }
}

/* ================================================================
 * Pharmacy — catalogue + index de recherche
 * ================================================================ */
struct Pharmacy {
    str name;
    str city;
    Medicine* medicines;
    int count;
    int capacity;
    SearchIndex* index;     /* vient du sous-projet `search` */
    bool index_dirty;       /* vrai si le catalogue a change depuis l'indexation */

    void init(str name, str city, int capacity) {
        self.name = name;
        self.city = city;
        self.capacity = capacity > 0 ? capacity : 32;
        self.medicines = alloc<Medicine>(self.capacity);
        self.count = 0;
        self.index = new SearchIndex(self.capacity * 4);
        self.index_dirty = true;
    }

    int size() { return self.count; }

    /* ajoute un medicament et invalide l'index */
    void add_medicine(Medicine* medicine) {
        if (self.count >= self.capacity) { self.grow(); }
        self.medicines[self.count] = *medicine;
        self.count = self.count + 1;
        self.index_dirty = true;
    }

    void grow() {
        int new_capacity = self.capacity * 2;
        Medicine* bigger = alloc<Medicine>(new_capacity);
        for i in range(self.count) { bigger[i] = self.medicines[i]; }
        self.medicines = bigger;
        self.capacity = new_capacity;
    }

    /* (re)construit l'index inverse. Trois familles de cles, avec des
       poids distincts : le nom commercial prime sur la molecule, qui
       prime sur les symptomes. */
    void rebuild_index() {
        if (!self.index_dirty) { return; }
        self.index = new SearchIndex(self.capacity * 4);
        for i in range(self.count) {
            int id = self.medicines[i].id;
            self.index.add(self.medicines[i].name, id, 50);
            self.index.add(self.medicines[i].molecule, id, 30);
            /* chaque mot des symptomes devient une cle */
            str symptoms = self.medicines[i].symptoms;
            int start = 0;
            int n = symptoms.len();
            for j in range(n + 1) {
                if (j == n || symptoms.slice(j, j + 1) == " ") {
                    if (j > start) {
                        self.index.add(symptoms.slice(start, j), id, 10);
                    }
                    start = j + 1;
                }
            }
        }
        self.index_dirty = false;
    }

    /* retrouve un medicament par identifiant */
    Medicine* find_by_id(int id) {
        for i in range(self.count) {
            if (self.medicines[i].id == id) { return &self.medicines[i]; }
        }
        return null;
    }

    /* recherche integree : delegue a l'index, deduplique par medicament.
       Retourne le nombre de resultats distincts. */
    int search(str term, SearchHit* hits, int max_hits) {
        self.rebuild_index();
        /* on demande plus de resultats que necessaire car plusieurs cles
           (nom, molecule, symptome) peuvent pointer le meme medicament */
        int raw_max = max_hits * 4;
        SearchHit* raw = alloc<SearchHit>(raw_max);
        int raw_count = self.index.search(term, raw, raw_max);

        int found = 0;
        for i in range(raw_count) {
            /* deja retenu ? on garde le meilleur score */
            bool seen = false;
            for j in range(found) {
                if (hits[j].id == raw[i].id) { seen = true; }
            }
            if (!seen && found < max_hits) {
                hits[found].id = raw[i].id;
                hits[found].score = raw[i].score;
                found = found + 1;
            }
        }
        return found;
    }

    /* liste les medicaments d'une categorie ; remplit ids, retourne le compte */
    int list_by_category(Category category, int* ids, int max_ids) {
        int found = 0;
        for i in range(self.count) {
            if (self.medicines[i].category == category && found < max_ids) {
                ids[found] = self.medicines[i].id;
                found = found + 1;
            }
        }
        return found;
    }

    /* verifie qu'une commande est honorable, sans la valider */
    CatalogResult check_order(int medicine_id, int quantity, bool has_prescription) {
        if (quantity <= 0) { return CatalogResult.INVALID_AMOUNT; }
        Medicine* medicine = self.find_by_id(medicine_id);
        if (medicine == null) { return CatalogResult.NOT_FOUND; }
        if (medicine.needs_prescription() && !has_prescription) {
            return CatalogResult.NEEDS_RX;
        }
        if (medicine.stock < quantity) { return CatalogResult.OUT_OF_STOCK; }
        return CatalogResult.SUCCESS;
    }

    /* decremente le stock apres validation */
    CatalogResult commit_order(int medicine_id, int quantity, bool has_prescription) {
        CatalogResult check = self.check_order(medicine_id, quantity, has_prescription);
        if (check != CatalogResult.SUCCESS) { return check; }
        Medicine* medicine = self.find_by_id(medicine_id);
        medicine.stock = medicine.stock - quantity;
        return CatalogResult.SUCCESS;
    }

    /* valeur totale du stock, en centimes */
    int stock_value_cents() {
        int total = 0;
        for i in range(self.count) {
            total = total + self.medicines[i].price_cents * self.medicines[i].stock;
        }
        return total;
    }
}

/* traduit un code de resultat en message lisible */
str catalog_result_text(CatalogResult result) {
    match (result) {
        CatalogResult.SUCCESS        => { return "Operation reussie"; }
        CatalogResult.OUT_OF_STOCK   => { return "Stock insuffisant"; }
        CatalogResult.NOT_FOUND      => { return "Medicament introuvable"; }
        CatalogResult.NEEDS_RX       => { return "Ordonnance obligatoire"; }
        CatalogResult.INVALID_AMOUNT => { return "Quantite invalide"; }
    }
    return "Erreur inconnue";
}

int catalog_module_main() { return 0; }
